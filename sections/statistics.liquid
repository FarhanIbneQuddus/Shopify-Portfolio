{% render 'neu-settings', section: section %}

<style>
  .neu-stats {
    background: var(--neu-bg);
    color: var(--neu-text);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .neu-stats__container {
    max-width: {{ section.settings.max_width | default: 1400 }}px;
    margin: 0 auto;
    padding: 0px;
  }

  @media (max-width: 749px){
    .neu-stats__container {
      max-width: {{ section.settings.max_width | default: 1400 }}px;
      margin: 0 auto;
      padding: 0 24px;
    }
  }


  .neu-stats__wrapper {
    padding: clamp(30px, 5vw, 60px) clamp(20px, 4vw, 50px);
    background: var(--neu-bg);
    box-shadow: var(--shadow-neu-in);
    border-radius: calc(var(--neu-radius) * 1.5);
  }

  .neu-stats__header {
    text-align: center;
    margin-bottom: 50px;
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s ease;
  }

  .neu-stats__header.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .neu-stats__badge {
    display: inline-flex;
    padding: 8px 20px;
    background: var(--neu-bg);
    box-shadow: var(--neu-shadow-strong);
    border-radius: 50px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--neu-accent);
    margin-bottom: 20px;
  }

  .neu-stats__title {
    font-size: clamp(28px, 4.5vw, 48px);
    font-weight: 900;
    margin: 0 0 10px;
  }

  .neu-stats__subtitle {
    font-size: 16px;
    opacity: 0.6;
    color: var(--neu-text-muted);
  }

  .neu-stats__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
  }

  /* Stat Card */
  .neu-stat-card {
    text-align: center;
    padding: clamp(24px, 3vw, 40px) 20px;
    background: var(--neu-bg);
    box-shadow: var(--neu-shadow-strong);
    border-radius: var(--neu-radius);
    position: relative;
    overflow: hidden;
    opacity: 0;
    transform: translateY(40px) scale(0.95);
    transition: all 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .neu-stat-card.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  {% comment %} .neu-stat-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--neu-accent), var(--neu-accent));
    transform: scaleX(0);
    transition: transform 0.6s ease;
  } {% endcomment %}

  {% comment %} .neu-stat-card.is-visible::before {
    transform: scaleX(1);
    transition-delay: 0.5s;
  } {% endcomment %}

  .neu-stat-card:hover {
    box-shadow: var(--shadow-neu-in);
    transform: translateY(-8px) !important;
  }

  /* Icon */
  .neu-stat-card__icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 20px;
    background: var(--neu-bg);
    box-shadow: var(--shadow-neu-in);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    transition: all 0.2s ease;
  }

  .neu-stat-card:hover .neu-stat-card__icon {
    box-shadow: var(--neu-shadow-strong);
    transform: scale(1.1) rotate(5deg);
  }

  /* Number */
  .neu-stat-card__number {
    font-size: clamp(38px, 5vw, 56px);
    font-weight: 900;
    line-height: 1;
    margin-bottom: 8px;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 2px;
  }

  .neu-stat-card__counter {
    display: inline-block;
    background: linear-gradient(135deg, var(--neu-accent), var(--neu-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .neu-stat-card__prefix,
  .neu-stat-card__suffix {
    font-size: 0.55em;
    background: linear-gradient(135deg, var(--neu-accent), var(--neu-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-weight: 700;
  }

  /* Label */
  .neu-stat-card__label {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    opacity: 0.5;
    margin-bottom: 16px;
  }

  /* Progress Bar */
  .neu-stat-card__bar {
    height: 6px;
    background: var(--neu-bg);
    box-shadow: var(--shadow-neu-in-sm);
    border-radius: 3px;
    overflow: hidden;
    margin-top: 4px;
  }

  .neu-stat-card__bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--neu-accent), var(--neu-accent));
    border-radius: 3px;
    width: 0%;
    transition: width 1.8s 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .neu-stat-card.is-visible .neu-stat-card__bar-fill {
    width: var(--bar-width);
  }

  /* Stagger */
  .neu-stat-card:nth-child(1) { transition-delay: 0s; }
  .neu-stat-card:nth-child(2) { transition-delay: 0.15s; }
  .neu-stat-card:nth-child(3) { transition-delay: 0.3s; }
  .neu-stat-card:nth-child(4) { transition-delay: 0.45s; }
  .neu-stat-card:nth-child(5) { transition-delay: 0.6s; }
  .neu-stat-card:nth-child(6) { transition-delay: 0.75s; }

  @media screen and (max-width: 749px) {
    .neu-stats__grid {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .neu-stat-card { padding: 20px 14px; }
  }

  @media screen and (max-width: 480px) {
    .neu-stats__grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .neu-stats__header, .neu-stat-card {
      opacity: 1 !important; transform: none !important; transition: none !important;
    }
    .neu-stat-card__bar-fill { transition: none !important; width: var(--bar-width) !important; }
    .neu-stat-card::before { transform: scaleX(1) !important; transition: none !important; }
  }
</style>

<section class="neu-stats" id="NeuStats-{{ section.id }}">
  <div class="neu-stats__container">
    <div class="neu-stats__wrapper">
      <div class="neu-stats__header" data-neu-reveal>
        {% if section.settings.badge != blank %}
          <div class="neu-stats__badge">{{ section.settings.badge }}</div>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="neu-stats__title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="neu-stats__subtitle">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>

      <div class="neu-stats__grid">
        {% for block in section.blocks %}
          <div class="neu-stat-card" data-neu-reveal {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}
              <div class="neu-stat-card__icon">{{ block.settings.icon }}</div>
            {% endif %}

            <div class="neu-stat-card__number">
              {% if block.settings.prefix != blank %}
                <span class="neu-stat-card__prefix">{{ block.settings.prefix }}</span>
              {% endif %}
              <span class="neu-stat-card__counter" data-counter-target="{{ block.settings.number }}">0</span>
              {% if block.settings.suffix != blank %}
                <span class="neu-stat-card__suffix">{{ block.settings.suffix }}</span>
              {% endif %}
            </div>

            {% if block.settings.label != blank %}
              <div class="neu-stat-card__label">{{ block.settings.label }}</div>
            {% endif %}

            {% if block.settings.bar_percent > 0 %}
              <div class="neu-stat-card__bar">
                <div class="neu-stat-card__bar-fill" style="--bar-width: {{ block.settings.bar_percent }}%;"></div>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script>
  (function(){
    const s = document.getElementById('NeuStats-{{ section.id }}');
    if (!s) return;

    const o = new IntersectionObserver((es) => {
      es.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          o.unobserve(e.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -50px 0px' });

    s.querySelectorAll('[data-neu-reveal]').forEach(el => o.observe(el));

    /* Counter */
    const co = new IntersectionObserver((es) => {
      es.forEach(e => {
        if (e.isIntersecting) {
          const el = e.target;
          const target = parseInt(el.dataset.counterTarget);
          if (isNaN(target)) return;
          const dur = 2200;
          const start = performance.now();

          function ease(t) { return 1 - Math.pow(1 - t, 4); }

          function tick(now) {
            const p = Math.min((now - start) / dur, 1);
            el.textContent = Math.floor(ease(p) * target).toLocaleString();
            if (p < 1) requestAnimationFrame(tick);
            else el.textContent = target.toLocaleString();
          }

          requestAnimationFrame(tick);
          co.unobserve(el);
        }
      });
    }, { threshold: 0.5 });

    s.querySelectorAll('[data-counter-target]').forEach(el => co.observe(el));
  })();
</script>

{% schema %}
{
  "name": "Statistics",
  "tag": "section",
  "class": "neu-stats-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Max Width", "min": 800, "max": 1600, "step": 50, "default": 1400, "unit": "px" },
    { "type": "range", "id": "padding_top", "label": "Padding Top", "min": 0, "max": 150, "step": 5, "default": 60, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding Bottom", "min": 0, "max": 150, "step": 5, "default": 60, "unit": "px" },
    { "type": "header", "content": "🎨 Neumorphic Colors" },
    { "type": "color", "id": "neu_bg", "label": "Background", "default": "#e6e9ee" },
    { "type": "color", "id": "neu_shadow_dark", "label": "Shadow Dark", "default": "#4f4e4e" },
    { "type": "color", "id": "neu_shadow_light", "label": "Shadow Light", "default": "#ffffff" },
    { "type": "color", "id": "neu_text", "label": "Text Color", "default": "#2c3e50" },
    { "type": "color", "id": "neu_text_muted", "label": "Muted Text", "default": "#8b95a3" },
    { "type": "color", "id": "neu_accent", "label": "Accent", "default": "#7d3fbf" },
    { "type": "header", "content": "📐 Shape" },
    { "type": "range", "id": "neu_radius", "label": "Border Radius", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 24 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "By the Numbers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Impact in Numbers" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Growing stronger every single day" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji Icon", "default": "🚀" },
        { "type": "text", "id": "number", "label": "Number (digits only)", "default": "5000" },
        { "type": "text", "id": "prefix", "label": "Prefix (before number)", "info": "e.g. $" },
        { "type": "text", "id": "suffix", "label": "Suffix (after number)", "default": "+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Happy Customers" },
        { "type": "range", "id": "bar_percent", "label": "Progress Bar %", "min": 0, "max": 100, "step": 5, "default": 85, "unit": "%" }
      ]
    }
  ],
  "presets": [{
    "name": "Statistics",
    "blocks": [
      { "type": "stat", "settings": { "icon": "😊", "number": "5000", "suffix": "+", "label": "Happy Customers", "bar_percent": 90 }},
      { "type": "stat", "settings": { "icon": "📦", "number": "150", "suffix": "+", "label": "Products", "bar_percent": 70 }},
      { "type": "stat", "settings": { "icon": "🌍", "number": "30", "label": "Countries", "bar_percent": 60 }},
      { "type": "stat", "settings": { "icon": "⭐", "number": "95", "suffix": "%", "label": "Satisfaction", "bar_percent": 95 }}
    ]
  }]
}
{% endschema %}