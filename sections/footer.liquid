<script>
  (function () {
    const collapsibles = document.querySelectorAll('.neubot-footer__collapsible');

    collapsibles.forEach((details) => {
      const summary = details.querySelector('.neubot-footer__summary');
      const wrapper = details.querySelector('.neubot-footer__collapsible-wrapper');
      const content = wrapper.querySelector('.neubot-footer__collapsible-content');

      const isMobile = () => window.matchMedia('(max-width: 640px)').matches;

      summary.addEventListener('click', (e) => {
        if (!isMobile()) return;

        e.preventDefault();
        const isOpen = details.classList.contains('is-open');

        if (isOpen) {
          const currentHeight = content.offsetHeight;
          wrapper.style.height = currentHeight + 'px';

          requestAnimationFrame(() => {
            wrapper.style.height = '0px';
            details.classList.remove('is-open');
          });

          const onClose = (event) => {
            if (event.propertyName !== 'height') return;
            details.removeAttribute('open');
            wrapper.style.height = '';
            wrapper.removeEventListener('transitionend', onClose);
          };
          wrapper.addEventListener('transitionend', onClose);
        } else {
          details.setAttribute('open', '');
          const targetHeight = content.offsetHeight;
          wrapper.style.height = '0px';

          requestAnimationFrame(() => {
            wrapper.style.height = targetHeight + 'px';
            details.classList.add('is-open');
          });

          const onOpen = (event) => {
            if (event.propertyName !== 'height') return;
            wrapper.style.height = 'auto';
            wrapper.removeEventListener('transitionend', onOpen);
          };
          wrapper.addEventListener('transitionend', onOpen);
        }
      });

      window.addEventListener('resize', () => {
        if (!isMobile()) {
          wrapper.style.height = '';
          details.classList.remove('is-open');
          details.removeAttribute('open');
        }
      });
    });
  })();
</script>

