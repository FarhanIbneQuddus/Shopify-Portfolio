{% render 'neu-settings', section: section %}

{% comment %}
  This section is used in the 404 template to render page shown when customers
  enter an invalid store URL.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/404
{% endcomment %}

{% style %}
  
  .section-{{ section.id }} .neu-404 {
    min-height: 70vh;
    display: grid;
    place-items: center;
    padding: clamp(3rem, 8vw, 6rem) 1.5rem;
  }

  .section-{{ section.id }} .neu-404__inner {
    width: min(100%, 760px);
  }

  .section-{{ section.id }} .neu-404__card {
    position: relative;
    overflow: hidden;
    padding: clamp(2rem, 4vw, 3.5rem);
    border-radius: var(--neu-radius);
    text-align: center;
    color: var(--neu-text);
    box-shadow: var(--neu-shadow-strong);
  }

 

  .section-{{ section.id }} .neu-404__card::before {
    width: 120px;
    height: 120px;
    top: -36px;
    left: -24px;
    box-shadow: var(--shadow-neu-out-sm);
  }

  .section-{{ section.id }} .neu-404__card::after {
    width: 90px;
    height: 90px;
    right: -18px;
    bottom: -24px;
    box-shadow: var(--shadow-neu-in-sm);
  }

  .section-{{ section.id }} .neu-404__code {
    width: clamp(88px, 12vw, 112px);
    height: clamp(88px, 12vw, 112px);
    margin: 0 auto 1.5rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--neu-text);
    background: linear-gradient(145deg, #edf1f6, #dde4ea);
    box-shadow: var(--shadow-neu-in);
  }

  .section-{{ section.id }} .neu-404__title {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1.05;
    font-weight: 800;
    color: var(--neu-text);
    text-shadow: 1px 1px 0 rgba(255, 255, 255, 0.7);
  }

  .section-{{ section.id }} .neu-404__text {
    max-width: 40ch;
    margin: 0 auto;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.7;
    color: var(--neu-muted);
  }

  .section-{{ section.id }} .neu-404__actions {
    margin-top: 2rem;
    display: flex;
    justify-content: center;
  }

  .section-{{ section.id }} .neu-404__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0.95rem 1.5rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--neu-text);
    background: linear-gradient(145deg, #eef2f6, #dde4ea);
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow: var(--neu-shadow-strong);
    transition: transform 180ms ease, box-shadow 180ms ease, color 180ms ease, background 180ms ease;
  }

  

  .section-{{ section.id }} .neu-404__button:active {
    transform: translateY(1px);
    box-shadow: var(--shadow-neu-in-sm);
  }

  .section-{{ section.id }} .neu-404__button:focus-visible {
    outline: none;
    color: var(--neu-accent);
    box-shadow: var(--shadow-neu-accent), 0 0 0 3px rgba(125, 106, 167, 0.18);
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }} .neu-404 {
      min-height: auto;
      padding: 3rem 1rem;
    }

    .section-{{ section.id }} .neu-404__card {
      padding: 2rem 1.25rem;
      border-radius: var(--neu-radius);
      box-shadow: var(--neu-shadow-strong);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-{{ section.id }} .neu-404__button {
      transition: none;
    }
  }
{% endstyle %}

<section class="section-{{ section.id }}">
  <div class="neu-404">
    <div class="neu-404__inner">
      <div class="neu-404__card">
        <div class="neu-404__code" aria-hidden="true">404</div>

        <p class="neu-404__text">
          {{ '404.not_found' | t }}
        </p>

        <div class="neu-404__actions">
          <a class="neu-404__button" href="{{ routes.all_products_collection_url }}">
            {{ '404.back_to_shopping' | t }}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:general.404",
  "settings": [
    {
      "type": "header",
      "content": "Neuromatic Colors"
    },
    {
      "type": "color",
      "id": "neu_bg",
      "label": "Background",
      "default": "#e6e9ee"
    },
    {
      "type": "color",
      "id": "neu_shadow_dark",
      "label": "Shadow Dark",
      "default": "#4f4e4e"
    },
    {
      "type": "color",
      "id": "neu_shadow_light",
      "label": "Shadow Light",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "neu_text",
      "label": "Text",
      "default": "#2c3e50"
    },
    {
      "type": "color",
      "id": "neu_text_muted",
      "label": "Text Muted",
      "default": "#8b95a3"
    },
    {
      "type": "color",
      "id": "neu_accent",
      "label": "Accent",
      "default": "#7d3fbf"
    },
    {
      "type": "header",
      "content": "Shape"
    },
    {
      "type": "range",
      "id": "neu_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    }
  ]
}
{% endschema %}