{% render 'neu-settings', section: section %}

<section class="collections-section">
  <h1 class="collections-section__title">{{ 'collections.title' | t }}</h1>

  <div
    class="collections {{ section.settings.grid_item_width }}"
    style="--grid-gap: {{ section.settings.grid_gap }}px"
  >
    {% for collection in collections %}
      <a class="collection-card" href="{{ collection.url }}">
        {% if collection.featured_image %}
          <div class="collection-card__media">
            {% render 'image',
              class: 'collection-card__image',
              image: collection.featured_image,
              width: 600,
              height: 600,
              crop: 'center'
            %}
          </div>
        {% endif %}

        <div class="collection-card__content">
          <p class="collection-card__title">{{ collection.title }}</p>

          {% if collection.description %}
            <p class="collection-card__description">
              {{ collection.description | strip_html | truncatewords: 15 }}
            </p>
          {% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .collections-section {
    padding: 50px 0px;
    border-radius: var(--neu-radius);
  }

  .collections-section__title {
    margin: 0 0 1.5rem;
    display: inline-flex;
    align-items: center;
    padding: 0.9rem 1.25rem;
    border-radius: 999px;
    background: var(--neu-bg);
    box-shadow: var(--neu-shadow-strong);
    color: var(--neu-text);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .collections {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(var(--collection-card-size), 100%), 1fr));
    gap: max(14px, var(--grid-gap));
  }

  .collections--compact {
    --collection-card-size: 180px;
  }

  .collections--full {
    --collection-card-size: 280px;
  }

  .collection-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    min-height: 100%;
    padding: 1rem;
    border-radius: var(--neu-radius);
    background: var(--neu-bg);
    box-shadow: var(--neu-shadow-strong);
    text-decoration: none;
    color: var(--neu-text);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .collection-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--neu-shadow-strong);
  }

  .collection-card:active {
    transform: translateY(0);
    box-shadow: var(--shadow-neu-in);
  }

  .collection-card:focus-visible {
    outline: none;
    box-shadow: var(--shadow-neu-accent);
  }

  .collection-card__media {
    padding: 0.8rem;
    border-radius: var(--neu-radius);
    background: linear-gradient(145deg, #edf1f5, #e6ebf0);
    box-shadow: var(--shadow-neu-in-sm);
    overflow: hidden;
  }

  .collection-card__image,
  .collection-card__media img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--neu-radius);
    box-shadow: var(--shadow-neu-out-sm);
  }

  .collection-card__content {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1rem;
    border-radius: var(--neu-radius);
    background: linear-gradient(145deg, #edf1f5, #e8ecf1);
    box-shadow: var(--shadow-neu-in-sm);
  }

  .collection-card__title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--neu-text);
  }

  .collection-card__description {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--neu-muted);
  }

  @media (min-width: 990px) {
    .collection-card:hover{
      box-shadow: var(--neu-shadow-strong);
    }
  }

  @media (max-width: 749px) {
    .collections-section {
      padding: 1rem;
      border-radius: 28px;
    }

    .collection-card {
      padding: 0.875rem;
      border-radius: 24px;
    }

    .collection-card__media,
    .collection-card__content {
      padding: 0.75rem;
      border-radius: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-card {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [
    {
      "type": "header",
      "content": "Neuromatic Colors"
    },
    {
      "type": "color",
      "id": "neu_bg",
      "label": "Background",
      "default": "#e6e9ee"
    },
    {
      "type": "color",
      "id": "neu_shadow_dark",
      "label": "Shadow Dark",
      "default": "#4f4e4e"
    },
    {
      "type": "color",
      "id": "neu_shadow_light",
      "label": "Shadow Light",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "neu_text",
      "label": "Text",
      "default": "#2c3e50"
    },
    {
      "type": "color",
      "id": "neu_text_muted",
      "label": "Text Muted",
      "default": "#8b95a3"
    },
    {
      "type": "header",
      "content": "Shape"
    },
    {
      "type": "range",
      "id": "neu_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "grid_item_width",
      "label": "t:labels.grid_item_width",
      "options": [
        { "value": "collections--compact", "label": "t:options.size.small" },
        { "value": "collections--full", "label": "t:options.size.large" }
      ],
      "default": "collections--full"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "t:labels.grid_gap",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 10
    }
  ],
  "presets": [{ "name": "t:general.collections_grid" }]
}
{% endschema %}
