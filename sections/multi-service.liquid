{% render 'neu-settings', section: section %}

<style>

  .neu-services {
    /* Neumorphic settings from snippet */
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background-color: var(--neu-bg);
  }

  .neu-services__container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .neu-services__header {
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: 40px;
  }

  .neu-services__title {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    color: var(--neu-text);
    margin: 0 0 8px;
    line-height: 1.2;
  }

  .neu-services__subtitle {
    font-size: 16px;
    color: var(--neu-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  /* ---- Grid ---- */

  .neu-services__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.gap }}px;
  }

  /* ---- Card ---- */

  .neu-service-card {
    background: var(--neu-bg);
    border-radius: {{ section.settings.card_radius }}px;
    box-shadow: var(--neu-shadow-strong);
    padding: 32px 28px 36px;
    /* Smooth, unified transition for all hover-affected properties */
    transition:
      box-shadow 0.6s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.6s cubic-bezier(0.4, 0, 0.2, 1),
      background-color 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    cursor: default;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    will-change: box-shadow, transform;
  }

  .neu-service-card:hover {
    box-shadow: var(--shadow-neu-in);
    transform: translateY(-2px);
  }

  .neu-service-card:hover .neu-service-card__icon-wrap {
    box-shadow: var(--shadow-neu-accent);
  }

  .neu-service-card:hover .neu-service-card__icon-wrap svg,
  .neu-service-card:hover .neu-service-card__icon-wrap img {
    transform: scale(1.1);
  }

  /* ---- Icon ---- */

  .neu-service-card__icon-wrap {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--neu-bg);
    box-shadow: var(--shadow-neu-in);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
    /* Smoother, longer transition to match the card */
    transition: box-shadow 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .neu-service-card__icon-wrap svg {
    width: 22px;
    height: 22px;
    color: var(--neu-accent);
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    flex-shrink: 0;
  }

  .neu-service-card__icon-wrap img {
    width: 22px;
    height: 22px;
    object-fit: contain;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    flex-shrink: 0;
  }

  /* ---- Typography ---- */

  .neu-service-card__heading {
    font-size: 20px;
    font-weight: 700;
    color: var(--neu-text);
    margin: 0 0 10px;
    line-height: 1.3;
    text-align: center;
  }

  .neu-service-card__text {
    font-size: 14px;
    line-height: 1.6;
    color: var(--neu-text-muted);
    margin: 0;
    text-align: center;
  }

  /* ---- Button ---- */

  .neu-service-card__btn-wrap {
    margin-top: 20px;
    text-align: center;
  }

  .neu-service-card__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 22px;
    font-size: 13px;
    font-weight: 600;
    color: var(--neu-accent);
    background: var(--neu-bg);
    border: none;
    border-radius: 24px;
    box-shadow: var(--shadow-neu-out-sm);
    cursor: pointer;
    text-decoration: none;
    transition:
      box-shadow 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      color 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    line-height: 1;
  }

  .neu-service-card__btn:hover {
    box-shadow: var(--shadow-neu-in-sm);
    color: var(--neu-accent);
    transform: translateY(1px);
  }

  .neu-service-card__btn svg {
    width: 14px;
    height: 14px;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .neu-service-card__btn:hover svg {
    transform: translateX(3px);
  }

  /* ============================================
     RESPONSIVE
     ============================================ */

  @media (max-width: 989px) {
    .neu-services__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .neu-service-card {
      padding: 26px 22px 30px;
    }

    .neu-service-card__heading {
      font-size: 18px;
    }

    .neu-services__title {
      font-size: calc({{ section.settings.heading_size }}px * 0.8);
    }
  }

  @media (max-width: 749px) {
    .neu-services {
      padding: {{ section.settings.padding_top | divided_by: 2 }}px 0 {{ section.settings.padding_bottom | divided_by: 2 }}px;
    }

    .neu-services__container {
      padding: 0 16px;
    }

    .neu-services__header {
      margin-bottom: 28px;
    }

    .neu-services__grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .neu-service-card {
      padding: 24px 20px 28px;
    }

    .neu-service-card__icon-wrap {
      width: 46px;
      height: 46px;
      margin-bottom: 18px;
    }

    .neu-service-card__icon-wrap svg,
    .neu-service-card__icon-wrap img {
      width: 20px;
      height: 20px;
    }

    .neu-service-card__heading {
      font-size: 17px;
    }

    .neu-service-card__text {
      font-size: 13px;
    }

    .neu-services__title {
      font-size: calc({{ section.settings.heading_size }}px * 0.65);
    }
  }
</style>

<section class="neu-services" id="section-{{ section.id }}">
  <div class="neu-services__container">

    {% if section.settings.heading != blank or section.settings.subtitle != blank %}
      <div class="neu-services__header">
        {% if section.settings.heading != blank %}
          <h2 class="neu-services__title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="neu-services__subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="neu-services__grid">
        {% for block in section.blocks %}
          <div class="neu-service-card" {{ block.shopify_attributes }}>

            {%- comment -%} Icon {%- endcomment -%}
            <div class="neu-service-card__icon-wrap">
              {% if block.settings.icon_image != blank %}
                <img
                  src="{{ block.settings.icon_image | image_url: width: 64 }}"
                  alt="{{ block.settings.heading | escape }}"
                  width="22"
                  height="22"
                  loading="lazy"
                >
              {% else %}
                {%- case block.settings.icon_name -%}
                  {%- when 'bolt' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                  {%- when 'shield' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  {%- when 'heart' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  {%- when 'star' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  {%- when 'cpu' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>
                  {%- when 'globe' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                  {%- when 'lock' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  {%- when 'zap' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                  {%- when 'settings' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                  {%- when 'check-circle' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  {%- else -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                {%- endcase -%}
              {% endif %}
            </div>

            {%- comment -%} Heading {%- endcomment -%}
            {% if block.settings.heading != blank %}
              <h3 class="neu-service-card__heading">{{ block.settings.heading }}</h3>
            {% endif %}

            {%- comment -%} Description {%- endcomment -%}
            {% if block.settings.description != blank %}
              <p class="neu-service-card__text">{{ block.settings.description }}</p>
            {% endif %}

            {%- comment -%} Button {%- endcomment -%}
            {% if block.settings.button_label != blank %}
              <div class="neu-service-card__btn-wrap">
                <a
                  href="{{ block.settings.button_link | default: '#' }}"
                  class="neu-service-card__btn"
                >
                  {{ block.settings.button_label }}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
              </div>
            {% endif %}

          </div>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Multi Services",
  "tag": "section",
  "class": "section-neumorphic-services",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Services"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Everything you need, engineered with care."
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading font size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between cards",
      "min": 12,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Section max width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Neuromatic Colors"
    },
    {
      "type": "color",
      "id": "neu_bg",
      "label": "Background",
      "default": "#e6e9ee"
    },
    {
      "type": "color",
      "id": "neu_shadow_dark",
      "label": "Shadow Dark",
      "default": "#4f4e4e"
    },
    {
      "type": "color",
      "id": "neu_shadow_light",
      "label": "Shadow Light",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "neu_text",
      "label": "Text",
      "default": "#2c3e50"
    },
    {
      "type": "color",
      "id": "neu_text_muted",
      "label": "Text Muted",
      "default": "#8b95a3"
    },
    {
      "type": "color",
      "id": "neu_accent",
      "label": "Accent",
      "default": "#7d3fbf"
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image",
          "info": "Upload a custom icon image. If set, this overrides the icon selector below."
        },
        {
          "type": "select",
          "id": "icon_name",
          "label": "Icon (fallback)",
          "info": "Used when no icon image is uploaded.",
          "options": [
            { "value": "bolt", "label": "Bolt" },
            { "value": "shield", "label": "Shield" },
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star" },
            { "value": "cpu", "label": "CPU" },
            { "value": "globe", "label": "Globe" },
            { "value": "lock", "label": "Lock" },
            { "value": "zap", "label": "Zap" },
            { "value": "settings", "label": "Settings" },
            { "value": "check-circle", "label": "Check Circle" }
          ],
          "default": "bolt"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Service Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Brief description of the service goes here."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multi Services",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "icon_name": "bolt",
            "heading": "48-Hour Cell",
            "description": "Silicon-anode pack rated for two full days of active operation."
          }
        },
        {
          "type": "service",
          "settings": {
            "icon_name": "shield",
            "heading": "IP67 Chassis",
            "description": "Sealed against dust and momentary immersion. Studio to sidewalk."
          }
        },
        {
          "type": "service",
          "settings": {
            "icon_name": "heart",
            "heading": "Quiet Cortex",
            "description": "On-device intelligence with a 32 dB acoustic profile."
          }
        }
      ]
    }
  ]
}
{% endschema %}