{% render 'neu-settings', section: section %}

{%- style -%}
  .neu-contact-section {
    --neu-bg-alt: #e6e9ee;
    --neu-text-light: #b2bec3;
    --neu-accent-dark: #5a4bd1;
    --neu-success: #00b894;
    --neu-error: #d63031;
    --neu-white: #ffffff;

    --neu-radius-sm: 14px;
    --neu-radius-xs: 10px;
    --neu-transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* ========== SECTION PADDING ========== */
  .neu-contact-section .neu-section-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .neu-contact-section .neu-section-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ========== BASE SECTION ========== */
  .neu-contact-section {
    background: var(--neu-bg);
  }

  .neu-contact-wrapper {
    max-width: 1400px;
    margin: 0 auto;
  }

  @media (max-width: 749px){
    .neu-contact-wrapper {
      max-width: 1400px;
      margin: 0 auto;
      padding-left: 20px;
      padding-right: 20px;
    }
  }

  /* ========== HERO HEADER ========== */
  .neu-hero {
    text-align: center;
    margin-bottom: 50px;
  }

  .neu-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 24px;
    background: var(--neu-bg);
    box-shadow: var(--neu-shadow-strong);
    border-radius: 50px;
    font-size: 13px;
    font-weight: 600;
    color: var(--neu-accent);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 28px;
  }

  .neu-hero__badge-dot {
    width: 8px;
    height: 8px;
    background: var(--neu-accent);
    border-radius: 50%;
    animation: neu-pulse 2s ease-in-out infinite;
  }

  @keyframes neu-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.3); }
  }

  .neu-hero__title {
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 800;
    color: var(--neu-text);
    margin: 0 0 16px 0;
    line-height: 1.15;
    letter-spacing: -1.5px;
  }

  .neu-hero__title-accent {
    background: linear-gradient(135deg, var(--neu-accent), var(--neu-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .neu-hero__subtitle {
    font-size: 17px;
    color: var(--neu-text-muted);
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.7;
    font-weight: 400;
  }

  /* ========== MAIN LAYOUT ========== */
  .neu-contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: stretch;
  }

  @media screen and (min-width: 990px) {
    .neu-contact-grid {
      grid-template-columns: 1fr 2fr;
      gap: 44px;
    }
  }

  /* ========== INFO SIDEBAR ========== */
  .neu-info-sidebar {
    display: flex;
    flex-direction: column;
    gap: 28px;
    height: 100%;
  }

  /* Info Card */
  .neu-info-card {
    background: var(--neu-bg);
    box-shadow: var(--neu-shadow-strong);
    border-radius: var(--neu-radius);
    padding: 32px;
    transition: var(--neu-transition);
  }

  .neu-info-card:hover {
    box-shadow: var(--neu-shadow-strong);
  }

  .neu-info-card--grow {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .neu-info-card__header {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 24px;
  }

  .neu-info-card__icon-wrap {
    width: 48px;
    height: 48px;
    background: var(--neu-bg);
    box-shadow: var(--shadow-neu-out-sm);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .neu-info-card__icon-wrap svg {
    width: 22px;
    height: 22px;
    color: var(--neu-accent);
  }

  .neu-info-card__heading {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 2px;
  }

  .neu-info-card__title {
    font-size: 22px;
    font-weight: 700;
    color: var(--neu-text);
    margin: 0;
    letter-spacing: -0.3px;
  }

  .neu-info-card__subtitle {
    font-size: 16px;
    color: var(--neu-text-muted);
    margin: 0;
    line-height: 1.5;
    font-weight: 400;
  }

  /* Info Items */
  .neu-info-items {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .neu-info-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px;
    background: var(--neu-bg);
    box-shadow: var(--shadow-neu-in-sm);
    border-radius: var(--neu-radius-sm);
    transition: var(--neu-transition);
  }

  .neu-info-item:hover {
    box-shadow: var(--shadow-neu-in);
  }

  .neu-info-item__icon {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, var(--neu-accent), var(--neu-accent));
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .neu-info-item__icon svg {
    width: 18px;
    height: 18px;
    color: white;
  }

  .neu-info-item__content {
    flex: 1;
    min-width: 0;
  }

  .neu-info-item__label {
    font-size: 12px;
    font-weight: 600;
    color: var(--neu-text-light);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 4px;
  }

  .neu-info-item__value {
    font-size: 14px;
    font-weight: 600;
    color: var(--neu-text);
    text-decoration: none;
    line-height: 1.5;
    word-break: break-word;
  }

  .neu-info-item__value a {
    color: var(--neu-text);
    text-decoration: none;
    transition: color 0.2s;
  }

  .neu-info-item__value a:hover {
    color: var(--neu-accent);
  }

  /* ========== SOCIAL CIRCLES ========== */
  .neu-social-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 22px;
    padding: 12px 4px 4px;
  }

  .neu-social-circle {
    width: 62px;
    height: 62px;
    border-radius: 50%;
    background: var(--neu-bg);
    box-shadow: var(--neu-shadow-strong);
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: var(--neu-transition);
    color: var(--neu-text);
  }

  .neu-social-circle:hover {
    color: var(--neu-accent);
    transform: translateY(2px);
  }

  .neu-social-circle:active {
    box-shadow: var(--shadow-neu-in-sm);
    color: var(--neu-accent);
    transform: translateY(2px);
  }

  .neu-social-circle svg {
    width: 22px;
    height: 22px;
    transition: transform 0.3s ease;
    display: block;
  }

  .neu-social-circle:hover svg {
    transform: scale(1.1);
  }

  /* ========== FORM CARD ========== */
  .neu-form-card {
    background: var(--neu-bg);
    box-shadow: var(--neu-shadow-strong);
    border-radius: var(--neu-radius);
    padding: 40px;
    transition: var(--neu-transition);
    height: 100%;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .neu-form-card__header {
    margin-bottom: 32px;
  }

  .neu-form-card__title {
    font-size: 24px;
    font-weight: 700;
    color: var(--neu-text);
    margin: 0 0 8px 0;
    letter-spacing: -0.5px;
  }

  .neu-form-card__desc {
    font-size: 14px;
    color: var(--neu-text-muted);
    margin: 0;
    line-height: 1.6;
  }

  .neu-contact-form {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* Form Status Messages */
  .neu-form-success {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 22px;
    background: var(--neu-bg);
    box-shadow: var(--shadow-neu-in-sm);
    border-radius: var(--neu-radius-sm);
    margin-bottom: 28px;
    border-left: 4px solid var(--neu-success);
  }

  .neu-form-success svg {
    width: 24px;
    height: 24px;
    color: var(--neu-success);
    flex-shrink: 0;
  }

  .neu-form-success span {
    font-size: 14px;
    font-weight: 600;
    color: var(--neu-success);
  }

  .neu-form-error {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px 22px;
    background: var(--neu-bg);
    box-shadow: var(--shadow-neu-in-sm);
    border-radius: var(--neu-radius-sm);
    margin-bottom: 28px;
    border-left: 4px solid var(--neu-error);
  }

  .neu-form-error__header {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .neu-form-error__header svg {
    width: 20px;
    height: 20px;
    color: var(--neu-error);
    flex-shrink: 0;
  }

  .neu-form-error__header span {
    font-size: 14px;
    font-weight: 600;
    color: var(--neu-error);
  }

  .neu-form-error__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .neu-form-error__list a {
    font-size: 13px;
    color: var(--neu-error);
    text-decoration: underline;
  }

  /* Form Fields */
  .neu-form__fields {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .neu-form__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  @media screen and (min-width: 750px) {
    .neu-form__row--2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  .neu-form__row--grow {
    flex: 1;
    display: flex;
  }

  .neu-form__group {
    position: relative;
  }

  .neu-form__group--grow {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .neu-form__group--grow .neu-form__input-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .neu-form__group--grow .neu-form__textarea {
    flex: 1;
  }

  .neu-form__label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--neu-text);
    margin-bottom: 10px;
    letter-spacing: 0.3px;
  }

  .neu-form__label .neu-required {
    color: var(--neu-accent);
    margin-left: 2px;
  }

  .neu-form__input-wrap {
    position: relative;
  }

  .neu-form__input-icon {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    color: var(--neu-text-light);
    pointer-events: none;
    transition: var(--neu-transition);
    z-index: 2;
  }

  .neu-form__input {
    width: 100%;
    padding: 16px 18px 16px 48px;
    background: var(--neu-bg);
    box-shadow: var(--shadow-neu-in-sm);
    border: 2px solid transparent;
    border-radius: var(--neu-radius-sm);
    font-size: 14px;
    font-weight: 500;
    color: var(--neu-text);
    transition: var(--neu-transition);
    outline: none;
    font-family: inherit;
    box-sizing: border-box;
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
  }

  .neu-form__input::placeholder {
    color: var(--neu-text-light);
    font-weight: 400;
  }

  .neu-form__input:focus {
    box-shadow: var(--shadow-neu-in);
    border-color: var(--neu-accent);
  }

  .neu-form__input:focus ~ .neu-form__input-icon,
  .neu-form__input:focus + .neu-form__input-icon {
    color: var(--neu-accent);
  }

  .neu-form__textarea {
    width: 100%;
    padding: 18px 18px 18px 48px;
    background: var(--neu-bg);
    box-shadow: var(--shadow-neu-in-sm);
    border: 2px solid transparent;
    border-radius: var(--neu-radius-sm);
    font-size: 14px;
    font-weight: 500;
    color: var(--neu-text);
    transition: var(--neu-transition);
    outline: none;
    font-family: inherit;
    resize: vertical;
    min-height: 140px;
    box-sizing: border-box;
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
  }

  .neu-form__textarea::placeholder {
    color: var(--neu-text-light);
    font-weight: 400;
  }

  .neu-form__textarea:focus {
    box-shadow: var(--shadow-neu-in);
    border-color: var(--neu-accent);
  }

  .neu-form__textarea:focus ~ .neu-form__input-icon {
    color: var(--neu-accent);
  }

  .neu-form__textarea-icon {
    top: 20px;
    transform: none;
  }

  .neu-form__field-error {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    font-size: 12px;
    font-weight: 500;
    color: var(--neu-error);
  }

  .neu-form__field-error svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  /* Subject Select */
  .neu-form__select-wrap {
    position: relative;
  }

  .neu-form__select {
    width: 100%;
    padding: 16px 48px 16px 48px;
    background: var(--neu-bg);
    box-shadow: var(--shadow-neu-in-sm);
    border: 2px solid transparent;
    border-radius: var(--neu-radius-sm);
    font-size: 14px;
    font-weight: 500;
    color: var(--neu-text);
    transition: var(--neu-transition);
    outline: none;
    font-family: inherit;
    cursor: pointer;
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    box-sizing: border-box;
  }

  .neu-form__select:focus {
    box-shadow: var(--shadow-neu-in);
    border-color: var(--neu-accent);
  }

  .neu-form__select-arrow {
    position: absolute;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: var(--neu-text-light);
    pointer-events: none;
  }

  /* Submit Button */
  .neu-form__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: nowrap;
  }

  .neu-form__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 18px 44px;
    background: linear-gradient(135deg, var(--neu-accent), var(--neu-accent));
    color: white;
    border: none;
    border-radius: var(--neu-radius-sm);
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: var(--neu-transition);
    box-shadow: var(--neu-shadow-strong);
    font-family: inherit;
    letter-spacing: 0.3px;
    position: relative;
    overflow: hidden;
  }

  /* .neu-form__submit::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 0%, rgba(255,255,255,0.15) 50%, transparent 100%);
    transform: translateX(-100%);
    transition: transform 0.6s ease;
  } */

  .neu-form__submit:hover {
    transform: translateY(-2px);
  }

  .neu-form__submit:hover::before {
    transform: translateX(100%);
  }

  .neu-form__submit:active {
    transform: translateY(1px);
    box-shadow: var(--shadow-neu-in-sm);
  }

  .neu-form__submit svg {
    width: 18px;
    height: 18px;
    transition: transform 0.3s ease;
  }

  .neu-form__submit:hover svg {
    transform: translateX(4px);
  }

  .neu-form__privacy {
    font-size: 12px;
    color: var(--neu-text-light);
    max-width: 260px;
    line-height: 1.6;
  }

  .neu-form__privacy a {
    color: var(--neu-accent);
    text-decoration: none;
    font-weight: 500;
  }

  .neu-form__privacy a:hover {
    text-decoration: underline;
  }

  /* ========== ANIMATIONS ========== */
  .neu-animate-in {
    opacity: 0;
    transform: translateY(30px);
    animation: neuFadeUp 0.7s ease forwards;
  }

  .neu-animate-in:nth-child(1) { animation-delay: 0.1s; }
  .neu-animate-in:nth-child(2) { animation-delay: 0.2s; }
  .neu-animate-in:nth-child(3) { animation-delay: 0.3s; }

  @keyframes neuFadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ========== RESPONSIVE ========== */
  @media screen and (max-width: 989px) {
    .neu-contact-grid {
      gap: 32px;
    }
  }

  @media screen and (max-width: 749px) {
    .neu-form-card {
      padding: 28px 22px;
    }

    .neu-info-card {
      padding: 24px;
    }

    .neu-form__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .neu-form__submit {
      width: 100%;
    }

    .neu-form__privacy {
      max-width: 100%;
      text-align: center;
    }

    .neu-social-list {
      gap: 18px;
      justify-content: center;
    }

    .neu-social-circle {
      width: 54px;
      height: 54px;
    }

    .neu-social-circle svg {
      width: 20px;
      height: 20px;
    }

    .neu-hero__title {
      font-size: 28px;
    }

    .neu-hero {
      margin-bottom: 32px;
    }
  }
{%- endstyle -%}

<div class="neu-contact-section">
  <div class="neu-contact-wrapper neu-section-padding">

    <!-- ===== HERO HEADER ===== -->
    <div class="neu-hero neu-animate-in">
      <div class="neu-hero__badge">
        <span class="neu-hero__badge-dot"></span>
        {{ section.settings.badge_text }}
      </div>
      {%- if section.settings.heading != blank -%}
        <h1 class="neu-hero__title">
          {{ section.settings.heading }}
        </h1>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="neu-hero__subtitle">
          {{ section.settings.subtitle }}
        </p>
      {%- endif -%}
    </div>

    <!-- ===== MAIN GRID ===== -->
    <div class="neu-contact-grid">

      <!-- ===== LEFT: INFO SIDEBAR ===== -->
      <div class="neu-info-sidebar">

        <!-- Contact Info Card -->
        <div class="neu-info-card neu-animate-in">
          <div class="neu-info-card__header">
            {% comment %} <div class="neu-info-card__icon-wrap">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
            </div> {% endcomment %}
            <div class="neu-info-card__heading">
              <h3 class="neu-info-card__title">{{ section.settings.info_title }}</h3>
            </div>
          </div>

          <div class="neu-info-items">
            {%- if section.settings.contact_email != blank -%}
            <div class="neu-info-item">
              <div class="neu-info-item__icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
              </div>
              <div class="neu-info-item__content">
                <div class="neu-info-item__label">Email</div>
                <div class="neu-info-item__value">
                  <a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a>
                </div>
              </div>
            </div>
            {%- endif -%}

            {%- if section.settings.contact_phone != blank -%}
            <div class="neu-info-item">
              <div class="neu-info-item__icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
              </div>
              <div class="neu-info-item__content">
                <div class="neu-info-item__label">Phone</div>
                <div class="neu-info-item__value">
                  <a href="tel:{{ section.settings.contact_phone }}">{{ section.settings.contact_phone }}</a>
                </div>
              </div>
            </div>
            {%- endif -%}

            {%- if section.settings.contact_address != blank -%}
            <div class="neu-info-item">
              <div class="neu-info-item__icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z"/></svg>
              </div>
              <div class="neu-info-item__content">
                <div class="neu-info-item__label">Address</div>
                <div class="neu-info-item__value">{{ section.settings.contact_address }}</div>
              </div>
            </div>
            {%- endif -%}
          </div>
        </div>

        <!-- Social Media Card -->
        {%- if section.settings.show_social -%}
        <div class="neu-info-card neu-info-card--grow neu-animate-in">
          <div class="neu-info-card__header">
            <div class="neu-info-card__heading">
              <h3 class="neu-info-card__title">{{ section.settings.social_title }}</h3>
              {%- if section.settings.social_subtitle != blank -%}
                <p class="neu-info-card__subtitle">{{ section.settings.social_subtitle }}</p>
              {%- endif -%}
            </div>
          </div>
          <div class="neu-social-list">
            {%- if section.settings.social_facebook != blank -%}
            <a href="{{ section.settings.social_facebook }}" target="_blank" rel="noopener" class="neu-social-circle" aria-label="Facebook">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3V2z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            {%- endif -%}
            {%- if section.settings.social_instagram != blank -%}
            <a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener" class="neu-social-circle" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6"/>
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/>
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
              </svg>
            </a>
            {%- endif -%}
            {%- if section.settings.social_twitter != blank -%}
            <a href="{{ section.settings.social_twitter }}" target="_blank" rel="noopener" class="neu-social-circle" aria-label="X (Twitter)">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M4 4l6.5 8L4 20h2l5.5-6.8L16 20h4l-6.8-8.5L20 4h-2l-5.2 6.4L8 4H4z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            {%- endif -%}
            {%- if section.settings.social_snapchat != blank -%}
            <a href="{{ section.settings.social_snapchat }}" target="_blank" rel="noopener" class="neu-social-circle" aria-label="Snapchat">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M12 2c-2.5 0-4.5 1.5-5 4-.2.8-.1 2.2-.1 2.2l-1.6-.3c-.4-.1-.8.2-.7.6.1.4.3.8.7.9l1.7.4s-.8 2.8-3.5 3.8c-.3.1-.4.5-.2.7 1.2 1.2 3 1.4 3.8 1.5.1.3.2.8.4 1.1.1.2.3.3.5.3h.3c.8-.2 1.5-.8 2.7-.8s1.9.6 2.7.8h.3c.2 0 .4-.1.5-.3.2-.3.3-.8.4-1.1.8-.1 2.6-.3 3.8-1.5.2-.2.1-.6-.2-.7-2.7-1-3.5-3.8-3.5-3.8l1.7-.4c.4-.1.6-.5.7-.9.1-.4-.3-.7-.7-.6l-1.6.3s.1-1.4-.1-2.2c-.5-2.5-2.5-4-5-4z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            {%- endif -%}
            {%- if section.settings.social_tiktok != blank -%}
            <a href="{{ section.settings.social_tiktok }}" target="_blank" rel="noopener" class="neu-social-circle" aria-label="TikTok">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            {%- endif -%}
            {%- if section.settings.social_youtube != blank -%}
            <a href="{{ section.settings.social_youtube }}" target="_blank" rel="noopener" class="neu-social-circle" aria-label="YouTube">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="4" stroke="currentColor" stroke-width="1.6"/>
                <path d="M10 8.5L16 12L10 15.5V8.5Z" fill="currentColor"/>
              </svg>
            </a>
            {%- endif -%}
            {%- if section.settings.social_pinterest != blank -%}
            <a href="{{ section.settings.social_pinterest }}" target="_blank" rel="noopener" class="neu-social-circle" aria-label="Pinterest">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M12 2a10 10 0 0 0-3.64 19.33c-.1-.83-.18-2.1.04-3l1.33-5.63s-.34-.68-.34-1.68c0-1.58.92-2.76 2.06-2.76.97 0 1.44.73 1.44 1.6 0 .98-.62 2.44-.94 3.8-.27 1.13.57 2.05 1.68 2.05 2.02 0 3.57-2.13 3.57-5.2 0-2.72-1.95-4.62-4.74-4.62-3.23 0-5.12 2.42-5.12 4.92 0 .98.38 2.02.85 2.59.09.11.1.21.08.32l-.32 1.3c-.05.21-.17.25-.38.15C6.18 14.4 5.2 12.3 5.2 10.72 5.2 7.13 7.82 3.85 12.4 3.85c3.7 0 6.57 2.64 6.57 6.16 0 3.68-2.32 6.64-5.54 6.64-1.08 0-2.1-.56-2.45-1.22l-.67 2.54c-.24.93-.89 2.1-1.33 2.81A10 10 0 1 0 12 2z" fill="currentColor"/>
              </svg>
            </a>
            {%- endif -%}
            {%- if section.settings.social_linkedin != blank -%}
            <a href="{{ section.settings.social_linkedin }}" target="_blank" rel="noopener" class="neu-social-circle" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3V9zm7 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.3c0-1.27-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.8V21h-4V9z" fill="currentColor"/>
              </svg>
            </a>
            {%- endif -%}
            {%- if section.settings.social_whatsapp != blank -%}
            <a href="https://wa.me/{{ section.settings.social_whatsapp }}" target="_blank" rel="noopener" class="neu-social-circle" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M20.52 3.48A11.86 11.86 0 0 0 12.03 0C5.47 0 .13 5.33.13 11.89c0 2.09.55 4.13 1.6 5.93L0 24l6.34-1.66a11.87 11.87 0 0 0 5.68 1.45h.01c6.55 0 11.9-5.33 11.9-11.89 0-3.18-1.24-6.17-3.48-8.42zM12.03 21.79h-.01a9.86 9.86 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.64-.24-.37a9.83 9.83 0 0 1-1.51-5.28c0-5.45 4.44-9.88 9.9-9.88 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.89 6.98c0 5.45-4.44 9.9-9.89 9.9zm5.43-7.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51-.17-.01-.37-.01-.57-.01-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.08 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35z" fill="currentColor"/>
              </svg>
            </a>
            {%- endif -%}
          </div>
        </div>
        {%- endif -%}

      </div>

      <!-- ===== RIGHT: CONTACT FORM ===== -->
      <div class="neu-form-card">
        <div class="neu-form-card__header">
          <h2 class="neu-form-card__title">{{ section.settings.form_title }}</h2>
          {%- if section.settings.form_description != blank -%}
            <p class="neu-form-card__desc">{{ section.settings.form_description }}</p>
          {%- endif -%}
        </div>

        {%- liquid
          assign contact_form_class = 'neu-contact-form'
          if settings.animations_reveal_on_scroll
            assign contact_form_class = 'neu-contact-form scroll-trigger animate--slide-in'
          endif
        -%}

        {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}

          {%- if form.posted_successfully? -%}
            <div class="neu-form-success" tabindex="-1" autofocus>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>Thanks for contacting us. We'll get back to you as soon as possible.</span>
            </div>
          {%- elsif form.errors -%}
            <div class="neu-form-error" tabindex="-1" autofocus>
              <div class="neu-form-error__header">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>
                <span>Please adjust the following:</span>
              </div>
              <ul class="neu-form-error__list" role="list">
                <li>
                  <a href="#ContactForm-email">
                    {{ form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email }}
                  </a>
                </li>
              </ul>
            </div>
          {%- endif -%}

          <div class="neu-form__fields">
            <!-- Name & Email Row -->
            <div class="neu-form__row neu-form__row--2">
              <div class="neu-form__group">
                <label class="neu-form__label" for="ContactForm-name">Name</label>
                <div class="neu-form__input-wrap">
                  <input
                    class="neu-form__input"
                    autocomplete="name"
                    type="text"
                    id="ContactForm-name"
                    name="contact[Name]"
                    value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                    placeholder="John Doe"
                  >
                  <svg class="neu-form__input-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
                </div>
              </div>
              <div class="neu-form__group">
                <label class="neu-form__label" for="ContactForm-email">
                  Email <span class="neu-required">*</span>
                </label>
                <div class="neu-form__input-wrap">
                  <input
                    autocomplete="email"
                    type="email"
                    id="ContactForm-email"
                    class="neu-form__input"
                    name="contact[email]"
                    spellcheck="false"
                    autocapitalize="off"
                    value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                    aria-required="true"
                    {% if form.errors contains 'email' %}
                      aria-invalid="true"
                      aria-describedby="ContactForm-email-error"
                    {% endif %}
                    placeholder="john@example.com"
                  >
                  <svg class="neu-form__input-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
                </div>
                {%- if form.errors contains 'email' -%}
                  <div class="neu-form__field-error" id="ContactForm-email-error">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
                    <span>{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</span>
                  </div>
                {%- endif -%}
              </div>
            </div>

            <!-- Phone & Subject Row -->
            <div class="neu-form__row neu-form__row--2">
              <div class="neu-form__group">
                <label class="neu-form__label" for="ContactForm-phone">Phone number</label>
                <div class="neu-form__input-wrap">
                  <input
                    type="tel"
                    id="ContactForm-phone"
                    class="neu-form__input"
                    autocomplete="tel"
                    name="contact[Phone number]"
                    pattern="[0-9\-]*"
                    value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                    placeholder="+1 (555) 123-4567"
                  >
                  <svg class="neu-form__input-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
                </div>
              </div>
              <div class="neu-form__group">
                <label class="neu-form__label" for="ContactForm-subject">Subject</label>
                <div class="neu-form__select-wrap">
                  <select
                    id="ContactForm-subject"
                    class="neu-form__select"
                    name="contact[subject]"
                  >
                    <option value="" disabled selected>Choose a topic...</option>
                    <option value="General Inquiry">General Inquiry</option>
                    <option value="Order Support">Order Support</option>
                    <option value="Returns & Exchanges">Returns & Exchanges</option>
                    <option value="Product Question">Product Question</option>
                    <option value="Wholesale">Wholesale</option>
                    <option value="Partnership">Partnership</option>
                    <option value="Other">Other</option>
                  </select>
                  <svg class="neu-form__input-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z"/><path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z"/></svg>
                  <svg class="neu-form__select-arrow" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
                </div>
              </div>
            </div>

            <!-- Message -->
            <div class="neu-form__row neu-form__row--grow">
              <div class="neu-form__group neu-form__group--grow">
                <label class="neu-form__label" for="ContactForm-body">Comment</label>
                <div class="neu-form__input-wrap">
                  <textarea
                    rows="8"
                    id="ContactForm-body"
                    class="neu-form__textarea"
                    name="contact[Comment]"
                    placeholder="Tell us how we can help you..."
                  >{{- form.body -}}</textarea>
                  <svg class="neu-form__input-icon neu-form__textarea-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z"/></svg>
                </div>
              </div>
            </div>
          </div>

          <!-- Actions -->
          <div class="neu-form__actions">
            <button type="submit" class="neu-form__submit">
              <span>Send</span>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5"/></svg>
            </button>
            {%- if section.settings.privacy_text != blank -%}
              <p class="neu-form__privacy">{{ section.settings.privacy_text }}</p>
            {%- endif -%}
          </div>

        {%- endform -%}
      </div>

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Contact Form",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Neuromatic Colors"
    },
    {
      "type": "color",
      "id": "neu_bg",
      "label": "Background",
      "default": "#e6e9ee"
    },
    {
      "type": "color",
      "id": "neu_shadow_dark",
      "label": "Shadow Dark",
      "default": "#4f4e4e"
    },
    {
      "type": "color",
      "id": "neu_shadow_light",
      "label": "Shadow Light",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "neu_text",
      "label": "Text",
      "default": "#2c3e50"
    },
    {
      "type": "color",
      "id": "neu_text_muted",
      "label": "Text Muted",
      "default": "#8b95a3"
    },
    {
      "type": "color",
      "id": "neu_accent",
      "label": "Accent",
      "default": "#7d3fbf"
    },
    {
      "type": "header",
      "content": "Shape"
    },
    {
      "type": "range",
      "id": "neu_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Hero Section"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Get In Touch"
