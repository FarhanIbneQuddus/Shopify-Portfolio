{% render 'neu-settings', section: section %}

<style>
  #NeuTest-{{ section.id }} {
    /* Neumorphic settings from snippet */
  }

  .neu-test {
    background: var(--neu-bg);
    color: var(--neu-text);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    overflow: visible;
  }

  .neu-test__container {
    max-width: {{ section.settings.max_width | default: 1200 }}px;
    margin: 0 auto;
    padding: 0px;
  }

  @media (max-width: 749px){
    .neu-test__container {
      max-width: {{ section.settings.max_width | default: 1200 }}px;
      margin: 0 auto;
      padding: 0 24px;
    }
  }

  /* ===== HEADER ===== */
  .neu-test__header {
    text-align: center;
    margin-bottom: 50px;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .neu-test__header.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .neu-test__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 20px;
    background: var(--neu-bg);
    box-shadow: var(--shadow-neu-in-sm);
    border-radius: 50px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--neu-accent);
    margin-bottom: 20px;
  }

  .neu-test__title {
    font-size: clamp(28px, 5vw, 52px);
    font-weight: 900;
    margin: 0 0 12px;
  }

  .neu-test__subtitle {
    font-size: 16px;
    opacity: 0.6;
    margin: 0;
  }

  /* ===== SLIDER WRAPPER ===== */
  .neu-test__slider-wrap {
    position: relative;
    opacity: 0;
    transform: scale(0.95);
    transition: opacity 0.8s 0.2s ease, transform 0.8s 0.2s ease;
  }

  .neu-test__slider-wrap.is-visible {
    opacity: 1;
    transform: scale(1);
  }

  .neu-test__slider-outer {
    padding: 30px 10px;
    background: var(--neu-bg);
    box-shadow: var(--neu-shadow-strong);
    border-radius: calc(var(--neu-radius) * 1.5);
    position: relative;
    overflow: hidden;
  }

  .neu-test__big-quote {
    position: absolute;
    top: 20px;
    left: 40px;
    font-size: clamp(100px, 15vw, 180px);
    color: var(--neu-accent);
    opacity: 0.06;
    line-height: 0.8;
    pointer-events: none;
    z-index: 1;
  }

  .neu-test__blob {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
    opacity: 0.08;
  }

  .neu-test__blob--1 {
    width: 200px;
    height: 200px;
    top: -60px;
    right: -60px;
    background: var(--neu-accent);
    animation: neuTestBlob 10s ease-in-out infinite;
  }

  .neu-test__blob--2 {
    width: 150px;
    height: 150px;
    bottom: -40px;
    left: -40px;
    background: var(--neu-accent);
    opacity: 0.06;
    animation: neuTestBlob 12s 2s ease-in-out infinite reverse;
  }

  @keyframes neuTestBlob {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(10px, -10px) scale(1.1); }
  }

  /* ===== SLIDES ===== */
  .neu-test__slides {
    display: flex;
    transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    position: relative;
    z-index: 2;
    will-change: transform;
  }

  .neu-test__slide {
    min-width: 100%;
    flex-shrink: 0;
    padding: clamp(30px, 5vw, 60px) clamp(20px, 5vw, 80px);
    box-sizing: border-box;
  }

  .neu-test__slide-inner {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  /* Stars */
  .neu-test__stars {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-bottom: 28px;
  }

  .neu-test__star {
    width: 32px;
    height: 32px;
    background: var(--neu-bg);
    box-shadow: var(--shadow-neu-out-sm);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    opacity: 0;
    transform: scale(0) rotate(-30deg);
    transition: opacity 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
                transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .neu-test__slide.is-active .neu-test__star {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }

  .neu-test__slide.is-active .neu-test__star:nth-child(1) { transition-delay: 0.1s; }
  .neu-test__slide.is-active .neu-test__star:nth-child(2) { transition-delay: 0.2s; }
  .neu-test__slide.is-active .neu-test__star:nth-child(3) { transition-delay: 0.3s; }
  .neu-test__slide.is-active .neu-test__star:nth-child(4) { transition-delay: 0.4s; }
  .neu-test__slide.is-active .neu-test__star:nth-child(5) { transition-delay: 0.5s; }

  /* Quote text */
  .neu-test__quote {
    font-size: clamp(17px, 2.5vw, 24px);
    line-height: 1.7;
    font-style: italic;
    color: var(--neu-text);
    margin: 0 0 36px;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s 0.3s ease, transform 0.6s 0.3s ease;
    position: relative;
  }

  .neu-test__slide.is-active .neu-test__quote {
    opacity: 0.85;
    transform: translateY(0);
  }

  .neu-test__quote::before,
  .neu-test__quote::after {
    content: '\201C';
    font-size: 1.4em;
    color: var(--neu-accent);
    font-weight: 700;
  }

  .neu-test__quote::after { content: '\201D'; }

  /* Author */
  .neu-test__author {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s 0.5s ease, transform 0.6s 0.5s ease;
  }

  .neu-test__slide.is-active .neu-test__author {
    opacity: 1;
    transform: translateY(0);
  }

  .neu-test__avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    box-shadow: var(--shadow-neu-in-sm);
    overflow: hidden;
    flex-shrink: 0;
  }

  .neu-test__slide.is-active .neu-test__avatar {
    animation: neuTestAvatarPop 0.6s 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  @keyframes neuTestAvatarPop {
    from { transform: scale(0.5); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  .neu-test__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .neu-test__author-info {
    text-align: left;
  }

  .neu-test__author-name {
    font-size: 17px;
    font-weight: 800;
    color: var(--neu-text);
    margin-bottom: 3px;
  }

  .neu-test__author-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--neu-accent);
  }

  /* Company logo */
  .neu-test__company-logo {
    margin-top: 24px;
    display: flex;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.5s 0.7s ease;
  }

  .neu-test__slide.is-active .neu-test__company-logo {
    opacity: 0.4;
  }

  .neu-test__company-logo img {
    height: 30px;
    width: auto;
    object-fit: contain;
    filter: grayscale(100%);
    transition: filter 0.3s ease;
    display: block;
  }

  .neu-test__company-logo:hover img {
    filter: grayscale(0%);
    opacity: 1;
  }

  /* ===== NAVIGATION ===== */
  .neu-test__nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 30px;
    position: relative;
    z-index: 3;
  }

  .neu-test__nav-btn {
    width: 48px;
    height: 48px;
    background: var(--neu-bg);
    box-shadow: var(--neu-shadow-strong);
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
    color: var(--neu-accent);
    flex-shrink: 0;
  }

  .neu-test__nav-btn:hover {
    transform: scale(0.95);
  }

  .neu-test__nav-btn:active {
    box-shadow: var(--shadow-neu-in);
    transform: scale(0.9);
  }

  .neu-test__nav-btn svg {
    width: 18px;
    height: 18px;
    display: block;
  }

  /* ===== DOTS - REFINED PILL PAGINATION ===== */
  .neu-test__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 10px 18px;
    background: var(--neu-bg);
    box-shadow: var(--shadow-neu-in-sm);
    border-radius: 50px;
  }

  .neu-test__dot {
    /* Fixed height, animated width */
    width: 12px;
    height: 12px;
    background: transparent;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    padding: 0;
    position: relative;
    display: block;
    flex-shrink: 0;
    outline: none;
    -webkit-tap-highlight-color: transparent;
    transition: width 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    overflow: hidden;
  }

  /* Inset track background (visible on all dots) */
  .neu-test__dot::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--neu-bg);
    box-shadow: var(--shadow-neu-in-sm);
    border-radius: 50px;
    z-index: 0;
    transition: box-shadow 0.4s ease;
  }

  /* Progress fill - grows left-to-right on active dot */
  .neu-test__dot-progress {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0%;
    background: var(--neu-accent);
    border-radius: 50px;
    opacity: 0;
    z-index: 1;
    pointer-events: none;
    will-change: width;
    transition: opacity 0.3s ease;
  }

  /* Active state: dot expands into pill, progress fill becomes visible */
  .neu-test__dot.is-active {
    width: 56px;
  }

  .neu-test__dot.is-active .neu-test__dot-progress {
    opacity: 1;
  }

  /* Subtle hover ring for inactive dots */
  .neu-test__dot:hover:not(.is-active)::before {
    box-shadow: inset 2px 2px 5px var(--neu-shadow-dark),
                inset -2px -2px 5px var(--neu-shadow-light),
                0 0 0 1px rgba(var(--neu-accent-rgb), 0.25);
  }

  /* ===== RESPONSIVE ===== */
  @media screen and (max-width: 749px) {
    .neu-test__container {
      padding: 0 16px;
    }

    .neu-test__header {
      margin-bottom: 30px;
    }

    .neu-test__slider-outer {
      padding: 20px 5px;
      border-radius: var(--neu-radius);
    }

    .neu-test__slide {
      padding: 24px 16px;
    }

    .neu-test__big-quote {
      font-size: 80px;
      top: 10px;
      left: 15px;
    }

    .neu-test__star {
      width: 26px;
      height: 26px;
      font-size: 13px;
    }

    .neu-test__stars {
      margin-bottom: 20px;
    }

    .neu-test__quote {
      margin-bottom: 24px;
    }

    .neu-test__author {
      gap: 12px;
    }

    .neu-test__avatar {
      width: 48px;
      height: 48px;
    }

    .neu-test__author-name {
      font-size: 15px;
    }

    .neu-test__author-title {
      font-size: 12px;
    }

    .neu-test__nav {
      gap: 12px;
      margin-top: 20px;
    }

    .neu-test__nav-btn {
      width: 40px;
      height: 40px;
    }

    .neu-test__nav-btn svg {
      width: 14px;
      height: 14px;
    }

    .neu-test__dots {
      gap: 12px;
      padding: 8px 14px;
    }

    .neu-test__dot {
      width: 10px;
      height: 10px;
    }

    .neu-test__dot.is-active {
      width: 48px;
    }

    .neu-test__company-logo {
      margin-top: 16px;
    }

    .neu-test__company-logo img {
      height: 24px;
    }
  }

  @media screen and (max-width: 400px) {
    .neu-test__slide {
      padding: 20px 12px;
    }

    .neu-test__dot {
      width: 9px;
      height: 9px;
    }

    .neu-test__dot.is-active {
      width: 40px;
    }

    .neu-test__dots {
      gap: 10px;
      padding: 7px 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .neu-test__header,
    .neu-test__slider-wrap,
    .neu-test__star,
    .neu-test__quote,
    .neu-test__author,
    .neu-test__company-logo {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
      animation: none !important;
    }

    .neu-test__slide.is-active .neu-test__star,
    .neu-test__slide.is-active .neu-test__quote,
    .neu-test__slide.is-active .neu-test__author,
    .neu-test__slide.is-active .neu-test__company-logo {
      opacity: 1 !important;
      transform: none !important;
    }

    .neu-test__slide.is-active .neu-test__quote {
      opacity: 0.85 !important;
    }

    .neu-test__slides {
      transition: none !important;
    }

    .neu-test__blob {
      animation: none !important;
    }

    .neu-test__dot,
    .neu-test__dot::before,
    .neu-test__dot-progress {
      transition: none !important;
    }
  }
</style>

<section class="neu-test" id="NeuTest-{{ section.id }}">
  <div class="neu-test__container">
    <div class="neu-test__header" data-neu-reveal>
      {% if section.settings.badge != blank %}
        <div class="neu-test__badge">{{ section.settings.badge }}</div>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="neu-test__title">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="neu-test__subtitle">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="neu-test__slider-wrap" data-neu-reveal data-testimonial-slider>
      <div class="neu-test__slider-outer">
        <div class="neu-test__big-quote" aria-hidden="true">"</div>
        <div class="neu-test__blob neu-test__blob--1" aria-hidden="true"></div>
        <div class="neu-test__blob neu-test__blob--2" aria-hidden="true"></div>

        <div class="neu-test__slides" data-slides aria-live="polite">
          {% for block in section.blocks %}
            <div
              class="neu-test__slide {% if forloop.first %}is-active{% endif %}"
              data-slide
              role="group"
              aria-roledescription="slide"
              aria-label="Testimonial {{ forloop.index }} of {{ section.blocks.size }}"
              {{ block.shopify_attributes }}
            >
              <div class="neu-test__slide-inner">
                {% if block.settings.stars > 0 %}
                  <div class="neu-test__stars" aria-label="{{ block.settings.stars }} out of 5 stars">
                    {% for i in (1..block.settings.stars) %}
                      <div class="neu-test__star" aria-hidden="true">⭐</div>
                    {% endfor %}
                  </div>
                {% endif %}

                <p class="neu-test__quote">{{ block.settings.quote }}</p>

                <div class="neu-test__author">
                  {% if block.settings.avatar != blank %}
                    <div class="neu-test__avatar">
                      {{ block.settings.avatar | image_url: width: 120 | image_tag: loading: 'lazy', alt: block.settings.name }}
                    </div>
                  {% endif %}
                  <div class="neu-test__author-info">
                    {% if block.settings.name != blank %}
                      <div class="neu-test__author-name">{{ block.settings.name }}</div>
                    {% endif %}
                    {% if block.settings.title != blank %}
                      <div class="neu-test__author-title">{{ block.settings.title }}</div>
                    {% endif %}
                  </div>
                </div>

                {% if block.settings.company_logo != blank %}
                  <div class="neu-test__company-logo">
                    {{ block.settings.company_logo | image_url: width: 200 | image_tag: loading: 'lazy', alt: 'Company logo' }}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      {% if section.blocks.size > 1 %}
        <nav class="neu-test__nav" aria-label="Testimonial navigation">
          <button class="neu-test__nav-btn" data-prev aria-label="Previous testimonial">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          </button>

          <div class="neu-test__dots" role="tablist" aria-label="Testimonial slides">
            {% for block in section.blocks %}
              <button
                class="neu-test__dot {% if forloop.first %}is-active{% endif %}"
                data-dot="{{ forloop.index0 }}"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="Go to testimonial {{ forloop.index }}"
              >
                <span class="neu-test__dot-progress" data-dot-progress></span>
              </button>
            {% endfor %}
          </div>

          <button class="neu-test__nav-btn" data-next aria-label="Next testimonial">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </nav>
      {% endif %}
    </div>
  </div>
</section>

<script>
(function(){
  const section = document.getElementById('NeuTest-{{ section.id }}');
  if (!section) return;

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  section.querySelectorAll('[data-neu-reveal]').forEach(el => observer.observe(el));

  const slider = section.querySelector('[data-testimonial-slider]');
  if (!slider) return;

  const slidesContainer = slider.querySelector('[data-slides]');
  const slides = slider.querySelectorAll('[data-slide]');
  const dots = slider.querySelectorAll('[data-dot]');
  const dotProgresses = slider.querySelectorAll('[data-dot-progress]');
  const prevBtn = slider.querySelector('[data-prev]');
  const nextBtn = slider.querySelector('[data-next]');
  const total = slides.length;

  if (total <= 1) return;

  let current = 0;
  let autoplayTimer = null;
  let isHovered = false;
  const autoplayDelay = {{ section.settings.autoplay_speed | default: 5000 }};

  function goTo(idx) {
    idx = ((idx % total) + total) % total;
    current = idx;
    slidesContainer.style.transform = 'translateX(-' + (current * 100) + '%)';

    slides.forEach(function(slide, i) {
      if (i === current) {
        setTimeout(function() { slide.classList.add('is-active'); }, 100);
      } else {
        slide.classList.remove('is-active');
      }
    });

    dots.forEach(function(dot, i) {
      var isActive = i === current;
      dot.classList.toggle('is-active', isActive);
      dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
    });

    resetProgress();
  }

  function resetProgress() {
    /* Reset ALL progress fills to 0 */
    dotProgresses.forEach(function(p) {
      p.style.transition = 'none';
      p.style.width = '0%';
    });

    /* Force reflow */
    void slider.offsetWidth;

    /* Animate only the active dot's progress fill */
    var activeProgress = dotProgresses[current];
    if (activeProgress) {
      /* Slight delay so it starts after the pill expansion */
      setTimeout(function() {
        activeProgress.style.transition = 'width ' + autoplayDelay + 'ms linear';
        activeProgress.style.width = '100%';
      }, 50);
    }
  }

  function startAutoplay() {
    stopAutoplay();
    autoplayTimer = setInterval(function() {
      if (!isHovered) goTo(current + 1);
    }, autoplayDelay);
    resetProgress();
  }

  function stopAutoplay() {
    if (autoplayTimer) {
      clearInterval(autoplayTimer);
      autoplayTimer = null;
    }
  }

  function restartAutoplay() {
    stopAutoplay();
    startAutoplay();
  }

  if (prevBtn) {
    prevBtn.addEventListener('click', function() {
      goTo(current - 1);
      restartAutoplay();
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', function() {
      goTo(current + 1);
      restartAutoplay();
    });
  }

  dots.forEach(function(dot) {
    dot.addEventListener('click', function() {
      goTo(parseInt(this.dataset.dot, 10));
      restartAutoplay();
    });
  });

  slider.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowLeft') {
      goTo(current - 1);
      restartAutoplay();
    } else if (e.key === 'ArrowRight') {
      goTo(current + 1);
      restartAutoplay();
    }
  });

  slider.addEventListener('mouseenter', function() { isHovered = true; });
  slider.addEventListener('mouseleave', function() { isHovered = false; });

  var touchStartX = 0;
  var touchStartY = 0;
  var isSwiping = false;

  slider.addEventListener('touchstart', function(e) {
    touchStartX = e.changedTouches[0].screenX;
    touchStartY = e.changedTouches[0].screenY;
    isSwiping = true;
  }, { passive: true });

  slider.addEventListener('touchend', function(e) {
    if (!isSwiping) return;
    isSwiping = false;

    var diffX = touchStartX - e.changedTouches[0].screenX;
    var diffY = touchStartY - e.changedTouches[0].screenY;

    if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 50) {
      goTo(diffX > 0 ? current + 1 : current - 1);
      restartAutoplay();
    }
  }, { passive: true });

  document.addEventListener('visibilitychange', function() {
    if (document.hidden) {
      stopAutoplay();
    } else {
      startAutoplay();
    }
  });

  startAutoplay();
})();
</script>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "neu-testimonials-section",
