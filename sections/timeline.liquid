{% render 'neu-settings', section: section %}

<style>
  #NeuTimeline-{{ section.id }} {
    /* Neumorphic settings from snippet */
    --dot-size: 28px;
    --line-width: 4px;
    --item-gap: 30px;
  }

  /* ── Base ── */
  .neu-timeline {
    background: var(--neu-bg);
    color: var(--neu-text);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    overflow: visible;
  }

  .neu-timeline__container {
    max-width: {{ section.settings.max_width | default: 1400 }}px;
    margin: 0 auto;
    padding: 0px;
  }

  @media (max-width: 749px){
    .neu-timeline__container {
      max-width: {{ section.settings.max_width | default: 1400 }}px;
      margin: 0 auto;
      padding: 0 24px;
    }
  }

  /* ── Header ── */
  .neu-timeline__header {
    text-align: center;
    margin-bottom: 60px;
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .neu-timeline__header.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .neu-timeline__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 20px;
    background: var(--neu-bg);
    box-shadow: var(--shadow-neu-in-sm);
    border-radius: 50px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--neu-accent);
    margin-bottom: 20px;
  }

  .neu-timeline__title {
    font-size: clamp(30px, 5vw, 52px);
    font-weight: 900;
    margin: 0 0 12px;
  }

  .neu-timeline__subtitle {
    font-size: 16px;
    opacity: 0.6;
    margin: 0;
  }

  /* ── Track ── */
  .neu-timeline__track {
    position: relative;
    padding: 20px 0;
  }

  /* Central line — always runs through column 2 (the dot column) */
  .neu-timeline__line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: var(--line-width);
    transform: translateX(-50%);
    background: var(--neu-bg);
    box-shadow: var(--shadow-neu-in-sm);
    border-radius: 2px;
    overflow: hidden;
    z-index: 0;
  }

  .neu-timeline__line-fill {
    width: 100%;
    height: 0%;
    background: linear-gradient(180deg, var(--neu-accent), var(--neu-accent));
    border-radius: 2px;
    transition: height 0.1s linear;
    will-change: height;
  }

  /* ── Item — unified DOM order: dot-wrap, content, empty ── */
  .neu-timeline__item {
    position: relative;
    display: grid;
    grid-template-columns: 1fr var(--dot-size) 1fr;
    gap: 0 var(--item-gap);
    margin-bottom: 50px;
    /* Align dots to top so they stay on the line regardless of card height */
    align-items: start;
  }

  .neu-timeline__item:last-child {
    margin-bottom: 0;
  }

  /* ── Dot — always column 2 ── */
  .neu-timeline__dot-wrap {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    justify-content: center;
    /* Push dot down so it aligns with the card top area */
    padding-top: 28px;
    z-index: 2;
  }

  .neu-timeline__dot {
    width: var(--dot-size);
    height: var(--dot-size);
    border-radius: 50%;
    background: var(--neu-bg);
    box-shadow: var(--shadow-neu-out-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: box-shadow 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    position: relative;
    flex-shrink: 0;
  }

  .neu-timeline__dot-inner {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--neu-accent);
    transform: scale(0);
    transition: transform 0.5s 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .neu-timeline__item.is-visible .neu-timeline__dot-inner {
    transform: scale(1);
  }

  .neu-timeline__item:hover .neu-timeline__dot {
    box-shadow: var(--neu-shadow-strong);
    transform: scale(1.2);
  }

  /* Pulse ring */
  .neu-timeline__dot::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 2px solid var(--neu-accent);
    opacity: 0;
    transform: scale(0.8);
    pointer-events: none;
  }

  .neu-timeline__item.is-visible .neu-timeline__dot::after {
    animation: neuTimelinePulse 2s 0.5s ease-out forwards;
  }

  @keyframes neuTimelinePulse {
    0% { opacity: 0.6; transform: scale(0.8); }
    100% { opacity: 0; transform: scale(2); }
  }

  /* ── Content card ── */
  .neu-timeline__content {
    grid-row: 1;
    padding: 28px;
    background: var(--neu-bg);
    box-shadow: var(--neu-shadow-strong);
    border-radius: var(--neu-radius);
    transition: opacity 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                box-shadow 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    opacity: 0;
    position: relative;
  }

  /* Empty spacer */
  .neu-timeline__empty {
    grid-row: 1;
  }

  /* ODD items (1st, 3rd, 5th…): content LEFT (col 1) */
  .neu-timeline__item:nth-child(odd) .neu-timeline__content {
    grid-column: 1;
    text-align: right;
    transform: translateX(-40px);
  }

  .neu-timeline__item:nth-child(odd) .neu-timeline__empty {
    grid-column: 3;
  }

  /* EVEN items (2nd, 4th, 6th…): content RIGHT (col 3) */
  .neu-timeline__item:nth-child(even) .neu-timeline__content {
    grid-column: 3;
    text-align: left;
    transform: translateX(40px);
  }

  .neu-timeline__item:nth-child(even) .neu-timeline__empty {
    grid-column: 1;
  }

  /* Visible state */
  .neu-timeline__item.is-visible .neu-timeline__content {
    opacity: 1;
    transform: translateX(0);
  }

  /* Hover state */
  .neu-timeline__item:hover .neu-timeline__content {
    box-shadow: var(--neu-shadow-strong);
    transform: translateY(-5px);
  }

  /* ── Card inner elements ── */
  .neu-timeline__year {
    display: inline-block;
    padding: 4px 16px;
    background: linear-gradient(135deg, var(--neu-accent), var(--neu-accent));
    color: #fff;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 14px;
  }

  .neu-timeline__item-icon {
    display: inline-block;
    font-size: 28px;
    margin-bottom: 10px;
  }

  .neu-timeline__item-title {
    font-size: 20px;
    font-weight: 800;
    margin: 0 0 10px;
    color: var(--neu-text);
  }

  .neu-timeline__item-text {
    font-size: 14px;
    line-height: 1.7;
    opacity: 0.65;
    margin: 0;
  }

  /* ── Tablet ── */
  @media screen and (max-width: 900px) {
    #NeuTimeline-{{ section.id }} {
      --item-gap: 20px;
    }

    .neu-timeline__content {
      padding: 22px;
    }

    .neu-timeline__item-title {
      font-size: 18px;
    }
  }

  /* ── Mobile — single-column layout ── */
  @media screen and (max-width: 749px) {
    #NeuTimeline-{{ section.id }} {
      --dot-size: 24px;
      --item-gap: 16px;
    }

    .neu-timeline__header {
      margin-bottom: 40px;
    }

    .neu-timeline__item {
      grid-template-columns: var(--dot-size) 1fr;
      margin-bottom: 35px;
    }

    /* Line on the left, centered on the dot column */
    .neu-timeline__line {
      left: calc(var(--dot-size) / 2);
      transform: translateX(-50%);
    }

    .neu-timeline__dot-wrap {
      grid-column: 1;
      padding-top: 22px;
    }

    .neu-timeline__empty {
      display: none;
    }

    /* All content goes to column 2, regardless of odd/even */
    .neu-timeline__item:nth-child(odd) .neu-timeline__content,
    .neu-timeline__item:nth-child(even) .neu-timeline__content {
      grid-column: 2;
      text-align: left;
      transform: translateX(30px);
    }

    .neu-timeline__item.is-visible .neu-timeline__content {
      transform: translateX(0);
    }

    .neu-timeline__item:hover .neu-timeline__content {
      transform: translateY(-3px);
    }

    .neu-timeline__content {
      padding: 20px;
    }

    .neu-timeline__item-title {
      font-size: 17px;
    }

    .neu-timeline__item-text {
      font-size: 13px;
    }
  }

  /* ── Small mobile ── */
  @media screen and (max-width: 400px) {
    .neu-timeline__container {
      padding: 0 16px;
    }

    .neu-timeline__content {
      padding: 16px;
    }
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .neu-timeline__header,
    .neu-timeline__content,
    .neu-timeline__dot-inner,
    .neu-timeline__dot,
    .neu-timeline__line-fill {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
      animation: none !important;
    }
    .neu-timeline__dot::after {
      animation: none !important;
    }
  }
</style>

<section class="neu-timeline" id="NeuTimeline-{{ section.id }}">
  <div class="neu-timeline__container">
    <div class="neu-timeline__header" data-neu-reveal>
      {% if section.settings.badge != blank %}
        <div class="neu-timeline__badge">{{ section.settings.badge }}</div>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="neu-timeline__title">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="neu-timeline__subtitle">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="neu-timeline__track">
      <div class="neu-timeline__line">
        <div class="neu-timeline__line-fill" data-timeline-fill></div>
      </div>

      {% for block in section.blocks %}
        <div class="neu-timeline__item" data-neu-reveal {{ block.shopify_attributes }}>
          {%- comment -%}
            DOM order is always: dot-wrap, content, empty.
            CSS grid-column assignments handle left/right placement.
          {%- endcomment -%}
          <div class="neu-timeline__dot-wrap">
            <div class="neu-timeline__dot">
              <div class="neu-timeline__dot-inner"></div>
            </div>
          </div>

          <div class="neu-timeline__content">
            {% if block.settings.icon != blank %}
              <div class="neu-timeline__item-icon">{{ block.settings.icon }}</div>
            {% endif %}
            {% if block.settings.year != blank %}
              <span class="neu-timeline__year">{{ block.settings.year }}</span>
            {% endif %}
            <h3 class="neu-timeline__item-title">{{ block.settings.title }}</h3>
            {% if block.settings.text != blank %}
              <p class="neu-timeline__item-text">{{ block.settings.text }}</p>
            {% endif %}
          </div>

          <div class="neu-timeline__empty"></div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (function () {
    const section = document.getElementById('NeuTimeline-{{ section.id }}');
    if (!section) return;

    /* Reveal observer */
    const revealObserver = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
    );

    section.querySelectorAll('[data-neu-reveal]').forEach(function (el) {
      revealObserver.observe(el);
    });

    /* Line fill on scroll */
    const track = section.querySelector('.neu-timeline__track');
    const fill = section.querySelector('[data-timeline-fill]');

    if (track && fill) {
      let ticking = false;

      function updateFill() {
        const rect = track.getBoundingClientRect();
        const viewH = window.innerHeight;
        const scrolled = Math.max(0, viewH * 0.5 - rect.top);
        const pct = Math.min(100, Math.max(0, (scrolled / rect.height) * 100));
        fill.style.height = pct + '%';
        ticking = false;
      }

      function onScroll() {
        if (!ticking) {
          requestAnimationFrame(updateFill);
          ticking = true;
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      updateFill();
    }
  })();
</script>

{% schema %}
{
  "name": "Timeline",
  "tag": "section",
  "class": "neu-timeline-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "range", "id": "max_width", "label": "Max Width", "min": 700, "max": 1400, "step": 50, "default": 1400, "unit": "px" },
    { "type": "range", "id": "padding_top", "label": "Padding Top", "min": 0, "max": 150, "step": 5, "default": 60, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding Bottom", "min": 0, "max": 150, "step": 5, "default": 60, "unit": "px" },
    { "type": "header", "content": "Neuromatic Colors" },
    { "type": "color", "id": "neu_bg", "label": "Background", "default": "#e6e9ee" },
    { "type": "color", "id": "neu_shadow_dark", "label": "Shadow Dark", "default": "#4f4e4e" },
    { "type": "color", "id": "neu_shadow_light", "label": "Shadow Light", "default": "#ffffff" },
    { "type": "color", "id": "neu_text", "label": "Text", "default": "#2c3e50" },
    { "type": "color", "id": "neu_text_muted", "label": "Text Muted", "default": "#8b95a3" },
    { "type": "color", "id": "neu_accent", "label": "Accent", "default": "#7d3fbf" },
    { "type": "header", "content": "Shape" },
    { "type": "range", "id": "neu_radius", "label": "Border Radius", "min": 0, "max": 100, "step": 2, "default": 24, "unit": "px" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "Our Journey" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Milestones & Memories" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Key moments that shaped who we are today" }
  ],
  "blocks": [
    {
      "type": "event",
      "name": "Timeline Event",
      "limit": 12,
      "settings": [
        { "type": "text", "id": "year", "label": "Year / Date", "default": "2020" },
        { "type": "text", "id": "icon", "label": "Emoji Icon", "default": "🚀" },
        { "type": "text", "id": "title", "label": "Title", "default": "Company Founded" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Started with a dream in a small garage." }
      ]
    }
  ],
  "presets": [{
    "name": "Timeline",
    "blocks": [
      { "type": "event", "settings": { "year": "2018", "icon": "💡", "title": "The Idea", "text": "A simple idea sparked in a coffee shop conversation." }},
      { "type": "event", "settings": { "year": "2019", "icon": "🚀", "title": "Launch Day", "text": "Launched our first product to the world." }},
      { "type": "event", "settings": { "year": "2021", "icon": "🌍", "title": "Going Global", "text": "Expanded to 30+ countries worldwide." }},
      { "type": "event", "settings": { "year": "2024", "icon": "🏆", "title": "Industry Award", "text": "Recognized as a leader in innovation." }}
    ]
  }]
}
{% endschema %}