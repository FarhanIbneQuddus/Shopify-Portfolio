{% render 'neu-settings', section: section %}

<div class="neu-banner-wrapper" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="neu-banner neu-banner--{{ section.settings.layout }}">
      
      {%- if section.settings.image != blank or section.settings.video != blank -%}
        <div class="neu-banner__media">
          <div class="neu-banner__media-inner">
            {%- if section.settings.video != blank -%}
              <video 
                autoplay 
                muted 
                loop 
                playsinline
                class="neu-banner__video">
                <source src="{{ section.settings.video.sources[1].url }}" type="video/mp4">
              </video>
            {%- elsif section.settings.image != blank -%}
              {{ section.settings.image | image_url: width: 800 | image_tag: 
                loading: 'lazy', 
                class: 'neu-banner__image',
                alt: section.settings.image.alt | escape 
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'neu-banner__image placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <div class="neu-banner__content">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <h2 class="neu-banner__heading" {{ block.shopify_attributes }}>
                {{ block.settings.heading }}
              </h2>
            {%- when 'subheading' -%}
              <p class="neu-banner__subheading" {{ block.shopify_attributes }}>
                {{ block.settings.subheading }}
              </p>
            {%- when 'text' -%}
              <div class="neu-banner__text" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
            {%- when 'button' -%}
              <div class="neu-banner__button-wrap" {{ block.shopify_attributes }}>
                <a href="{{ block.settings.button_link }}" class="neu-banner__button">
                  {{ block.settings.button_label }}
                </a>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>

<style>
  .neu-banner-wrapper {
    background-color: var(--neu-bg);
  }

  .neu-banner {
    display: flex;
    align-items: center;
    gap: 40px;
    padding: 50px;
    border-radius: var(--neu-radius);
    background: var(--neu-bg);
    box-shadow: var(--neu-shadow-strong);
  }

  .neu-banner--image_right {
    flex-direction: row;
  }

  .neu-banner--image_left {
    flex-direction: row-reverse;
  }

  .neu-banner__media {
    flex: 0 0 30%;
    max-width: 30%;
  }

  .neu-banner__media-inner {
    border-radius: 20px;
    padding: 15px;
    box-shadow: var(--shadow-neu-in);
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .neu-banner__image,
  .neu-banner__video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 15px;
  }

  .neu-banner__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .neu-banner__heading {
    font-size: clamp(28px, 4vw, 52px);
    font-weight: 800;
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--neu-text);
  }

  .neu-banner__subheading {
    font-size: 16px;
    margin: 0;
    opacity: 0.75;
    line-height: 1.5;
    color: var(--neu-text-muted);
  }

  .neu-banner__text {
    font-size: 15px;
    line-height: 1.6;
    opacity: 0.8;
    color: var(--neu-text-muted);
  }

  .neu-banner__text p {
    margin: 0 0 10px 0;
  }

  .neu-banner__button-wrap {
    margin-top: 15px;
  }

  .neu-banner__button {
    display: inline-block;
    padding: 14px 32px;
    border-radius: 50px;
    background-color: var(--neu-bg);
    color: var(--neu-text);
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    box-shadow: var(--neu-shadow-strong);
    transition: all 0.3s ease;
  }


  .neu-banner__button:active {
    box-shadow: var(--shadow-neu-in-sm);
  }

  @media screen and (max-width: 749px) {
    .neu-banner-wrapper {
        padding: 50px 16px;
    }

    .neu-banner {
      flex-direction: column !important;
      padding: 30px 20px;
      gap: 25px;
      border-radius: var(--neu-radius);
    }
    
    .neu-banner__media {
      flex: 0 0 100%;
      max-width: 220px;
      width: 100%;
    }

    .neu-banner__content {
      text-align: center;
      align-items: center;
    }

    .neu-banner__heading {
      font-size: 32px;
    }
  }
</style>

{% schema %}
{
  "name": "Image with Text",
  "tag": "section",
  "class": "section-image-with-text-banner",
  "settings": [
    {
      "type": "header",
      "content": "Neuromatic Colors"
    },
    {
      "type": "color",
      "id": "neu_bg",
      "label": "Section Background",
      "default": "#e6e9ee"
    },
    {
      "type": "color",
      "id": "neu_shadow_dark",
      "label": "Shadow Dark",
      "default": "#4f4e4e"
    },
    {
      "type": "color",
      "id": "neu_shadow_light",
      "label": "Shadow Light",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "neu_text",
      "label": "Text Color",
      "default": "#2c3e50"
    },
    {
      "type": "color",
      "id": "neu_text_muted",
      "label": "Muted Text",
      "default": "#8b95a3"
    },
    {
      "type": "header",
      "content": "Shape"
    },
    {
      "type": "range",
      "id": "neu_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Position",
      "options": [
        { "value": "image_left", "label": "Image Left" },
        { "value": "image_right", "label": "Image Right" }
      ],
      "default": "image_right"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (overrides image)"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "First look. First drops."
        }
      ]
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Discover our latest collection"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 2,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Join 12,400 collectors who get our field notes and early access to new models — no noise, twice a month.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with Text"
    }
  ]
}
{% endschema %}