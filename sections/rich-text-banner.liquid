{% render 'neu-settings', section: section %}

<style>
  #NeuCTA-{{ section.id }} {
    /* Neumorphic settings from snippet */
  }

  .neu-cta {
    background: var(--neu-bg);
    color: var(--neu-text);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .neu-cta__container {
    max-width: {{ section.settings.max_width | default: 1400 }}px;
    margin: 0 auto;
    padding: 0px;
  }

  @media (max-width: 749px){
    .neu-cta__container {
      max-width: {{ section.settings.max_width | default: 1400 }}px;
      margin: 0 auto;
      padding: 0 24px;
    }
  }

  .neu-cta__box {
    padding: clamp(40px, 7vw, 80px) clamp(24px, 5vw, 60px);
    background: var(--neu-bg);
    box-shadow: var(--neu-shadow-strong);
    border-radius: calc(var(--neu-radius) * 1.5);
    text-align: center;
    position: relative;
    overflow: hidden;
    opacity: 0;
    transform: translateY(50px) scale(0.95);
    transition: all 1s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .neu-cta__box.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  /* Decorative orbs */
  .neu-cta__orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .neu-cta__orb--1 {
    width: 250px;
    height: 250px;
    top: -80px;
    right: -80px;
    background: radial-gradient(circle, rgba(var(--neu-accent-rgb), 0.12), transparent 70%);
    animation: neuCTAOrb 10s ease-in-out infinite;
  }

  .neu-cta__orb--2 {
    width: 200px;
    height: 200px;
    bottom: -60px;
    left: -60px;
    background: radial-gradient(circle, rgba(var(--neu-accent-rgb), 0.08), transparent 70%);
    animation: neuCTAOrb 14s 3s ease-in-out infinite reverse;
  }

  @keyframes neuCTAOrb {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(15px, -15px) scale(1.1); }
  }

  /* Floating shapes */
  {% comment %} .neu-cta__shape {
    position: absolute;
    background: var(--neu-bg);
    box-shadow: var(--shadow-neu-out-sm);
    pointer-events: none;
    opacity: 0;
    transition: opacity 1s 0.5s ease;
  }

  .neu-cta__box.is-visible .neu-cta__shape { opacity: 0.4; }

  .neu-cta__shape--1 {
    width: 50px; height: 50px; border-radius: 14px;
    top: 30px; left: 30px; transform: rotate(20deg);
    animation: neuCTAShapeFloat 8s ease-in-out infinite;
  }

  .neu-cta__shape--2 {
    width: 30px; height: 30px; border-radius: 50%;
    bottom: 40px; right: 50px;
    animation: neuCTAShapeFloat 6s 2s ease-in-out infinite;
  }

  .neu-cta__shape--3 {
    width: 40px; height: 40px; border-radius: 10px;
    top: 40%; right: 25px; transform: rotate(-15deg);
    animation: neuCTAShapeFloat 9s 1s ease-in-out infinite;
  }

  @keyframes neuCTAShapeFloat {
    0%, 100% { margin-top: 0; }
    50% { margin-top: -12px; }
  } {% endcomment %}

  .neu-cta__content {
    position: relative;
    z-index: 2;
  }

  .neu-cta__icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 28px;
    background: var(--neu-bg);
    box-shadow: var(--shadow-neu-in);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 36px;
    opacity: 0;
    transform: scale(0.5) rotate(-20deg);
    transition: all 0.8s 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .neu-cta__box.is-visible .neu-cta__icon {
    opacity: 1;
    transform: scale(1) rotate(0);
  }

  .neu-cta__title {
    font-size: clamp(28px, 5vw, 52px);
    font-weight: 900;
    margin: 0 0 16px;
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.6s 0.4s ease;
  }

  .neu-cta__box.is-visible .neu-cta__title {
    opacity: 1;
    transform: translateY(0);
  }

  .neu-cta__title-highlight {
    background: linear-gradient(135deg, var(--neu-accent), var(--neu-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .neu-cta__text {
    font-size: clamp(15px, 2vw, 18px);
    line-height: 1.7;
    max-width: 550px;
    margin: 0 auto 36px;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s 0.5s ease;
  }

  .neu-cta__box.is-visible .neu-cta__text {
    opacity: 0.7;
    transform: translateY(0);
  }

  .neu-cta__buttons {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s 0.6s ease;
  }

  .neu-cta__box.is-visible .neu-cta__buttons {
    opacity: 1;
    transform: translateY(0);
  }

  .neu-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 18px 40px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 16px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    position: relative;
    overflow: hidden;
  }

  .neu-cta__btn::before {
    content: '';
    position: absolute;
    top: 0; left: -100%; width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: left 0.6s ease;
  }

  .neu-cta__btn:hover::before { left: 100%; }

  .neu-cta__btn--primary {
    background: linear-gradient(135deg, var(--neu-accent), var(--neu-accent));
    color: #fff;
    box-shadow: var(--neu-shadow-strong);
  }

  .neu-cta__btn--primary:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: var(--neu-shadow-strong);
  }

  .neu-cta__btn--primary:active {
    transform: translateY(-1px) scale(0.98);
    box-shadow: inset -3px -3px 6px var(--neu-shadow-light),inset 3px 3px 6px var(--neu-shadow-dark);
  }

  .neu-cta__btn--secondary {
    background: var(--neu-bg);
    color: var(--neu-accent);
    box-shadow: var(--shadow-neu-out-sm);
  }

  .neu-cta__btn--secondary:hover {
    box-shadow: var(--shadow-neu-in-sm);
    transform: translateY(2px);
  }

  .neu-cta__btn-icon {
    display: inline-flex;
    transition: transform 0.3s ease;
  }

  .neu-cta__btn:hover .neu-cta__btn-icon { transform: translateX(4px); }

  /* Trust items */
  .neu-cta__trust {
    margin-top: 40px;
    display: flex;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
    opacity: 0;
    transition: all 0.6s 0.8s ease;
  }

  .neu-cta__box.is-visible .neu-cta__trust {
    opacity: 0.5;
  }

  .neu-cta__trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    transition: opacity 0.3s ease;
  }

  .neu-cta__trust-item:hover { opacity: 1; }

  @media screen and (max-width: 749px) {
    .neu-cta__buttons { flex-direction: column; align-items: stretch; }
    .neu-cta__btn { justify-content: center; }
    .neu-cta__shape { display: none; }
    .neu-cta__trust { flex-direction: column; align-items: center; gap: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .neu-cta__box, .neu-cta__icon, .neu-cta__title, .neu-cta__text,
    .neu-cta__buttons, .neu-cta__trust, .neu-cta__shape {
      opacity: 1 !important; transform: none !important;
      transition: none !important; animation: none !important;
    }
    .neu-cta__orb { animation: none !important; }
  }
</style>

<section class="neu-cta" id="NeuCTA-{{ section.id }}">
  <div class="neu-cta__container">
    <div class="neu-cta__box" data-neu-reveal>
      <div class="neu-cta__orb neu-cta__orb--1"></div>
      <div class="neu-cta__orb neu-cta__orb--2"></div>
      <div class="neu-cta__shape neu-cta__shape--1"></div>
      <div class="neu-cta__shape neu-cta__shape--2"></div>
      <div class="neu-cta__shape neu-cta__shape--3"></div>

      <div class="neu-cta__content">
        {% if section.settings.icon != blank %}
          <div class="neu-cta__icon">{{ section.settings.icon }}</div>
        {% endif %}

        {% if section.settings.title != blank %}
        <h2 class="neu-cta__title">
            {% assign parts = section.settings.title | split: '*' %}
            {% for part in parts %}
            {% assign modulo_result = forloop.index | modulo: 2 %}
            {% if modulo_result == 0 %}
                <span class="neu-cta__title-highlight">{{ part }}</span>
            {% else %}
                {{ part }}
            {% endif %}
            {% endfor %}
        </h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <p class="neu-cta__text">{{ section.settings.text }}</p>
        {% endif %}

        <div class="neu-cta__buttons">
          {% if section.settings.primary_text != blank %}
            <a href="{{ section.settings.primary_link }}" class="neu-cta__btn neu-cta__btn--primary">
              {{ section.settings.primary_text }}
              <span class="neu-cta__btn-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </a>
          {% endif %}
          {% if section.settings.secondary_text != blank %}
            <a href="{{ section.settings.secondary_link }}" class="neu-cta__btn neu-cta__btn--secondary">
              {{ section.settings.secondary_text }}
            </a>
          {% endif %}
        </div>

        {% if section.settings.trust_1 != blank or section.settings.trust_2 != blank or section.settings.trust_3 != blank %}
          <div class="neu-cta__trust">
            {% if section.settings.trust_1 != blank %}
              <div class="neu-cta__trust-item">
                <span>{{ section.settings.trust_1_icon | default: '✓' }}</span>
                {{ section.settings.trust_1 }}
              </div>
            {% endif %}
            {% if section.settings.trust_2 != blank %}
              <div class="neu-cta__trust-item">
                <span>{{ section.settings.trust_2_icon | default: '✓' }}</span>
                {{ section.settings.trust_2 }}
              </div>
            {% endif %}
            {% if section.settings.trust_3 != blank %}
              <div class="neu-cta__trust-item">
                <span>{{ section.settings.trust_3_icon | default: '✓' }}</span>
                {{ section.settings.trust_3 }}
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script>
(function(){
  const s = document.getElementById('NeuCTA-{{ section.id }}');
  if (!s) return;
  const o = new IntersectionObserver((es) => {
    es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-visible'); o.unobserve(e.target); }});
  }, { threshold: 0.15 });
  s.querySelectorAll('[data-neu-reveal]').forEach(el => o.observe(el));
})();
</script>

{% schema %}
{
  "name": "Rich Text Banner",
  "tag": "section",
  "class": "neu-cta-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "range", "id": "max_width", "label": "Max Width", "min": 700, "max": 1400, "step": 50, "default": 1400, "unit": "px" },
    { "type": "range", "id": "padding_top", "label": "Padding Top", "min": 0, "max": 150, "step": 5, "default": 60, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding Bottom", "min": 0, "max": 150, "step": 5, "default": 60, "unit": "px" },
    { "type": "header", "content": "Neuromatic Colors" },
    { "type": "color", "id": "neu_bg", "label": "Background", "default": "#e6e9ee" },
    { "type": "color", "id": "neu_shadow_dark", "label": "Shadow Dark", "default": "#4f4e4e" },
    { "type": "color", "id": "neu_shadow_light", "label": "Shadow Light", "default": "#ffffff" },
    { "type": "color", "id": "neu_text", "label": "Text", "default": "#2c3e50" },
    { "type": "color", "id": "neu_text_muted", "label": "Text Muted", "default": "#8b95a3" },
    { "type": "color", "id": "neu_accent", "label": "Accent", "default": "#7d3fbf" },
    { "type": "header", "content": "Shape" },
    { "type": "range", "id": "neu_radius", "label": "Border Radius", "min": 0, "max": 100, "step": 2, "default": 24, "unit": "px" },
    { "type": "text", "id": "icon", "label": "Emoji Icon", "default": "🚀" },
    { "type": "text", "id": "title", "label": "Title (wrap *text* for highlight)", "default": "Ready to *Get Started?*", "info": "Wrap text with * for gradient highlight" },
    { "type": "textarea", "id": "text", "label": "Description", "default": "Join thousands of happy customers and start your journey with us today." },
    { "type": "text", "id": "primary_text", "label": "Primary Button", "default": "Shop Now" },
    { "type": "url", "id": "primary_link", "label": "Primary Link" },
    { "type": "text", "id": "secondary_text", "label": "Secondary Button", "default": "Learn More" },
    { "type": "url", "id": "secondary_link", "label": "Secondary Link" },
    { "type": "header", "content": "Trust Items" },
    { "type": "text", "id": "trust_1", "label": "Trust 1", "default": "Free Shipping" },
    { "type": "text", "id": "trust_1_icon", "label": "Trust 1 Icon", "default": "🚚" },
    { "type": "text", "id": "trust_2", "label": "Trust 2", "default": "30-Day Returns" },
    { "type": "text", "id": "trust_2_icon", "label": "Trust 2 Icon", "default": "↩️" },
    { "type": "text", "id": "trust_3", "label": "Trust 3", "default": "Secure Payment" },
    { "type": "text", "id": "trust_3_icon", "label": "Trust 3 Icon", "default": "🔒" }
  ],
  "presets": [{ "name": "Rich Text Banner" }]
}
{% endschema %}