            "stat_1_label": "HAPPY BUILDERS",
            "stat_2_value": "4.7",
            "stat_2_label": "PARENT REVIEW AVG",
            "stat_3_value": "36 mo",
            "stat_3_label": "WARRANTY"
          }
        }
      ]
    }
  ]
}
{% endschema %}