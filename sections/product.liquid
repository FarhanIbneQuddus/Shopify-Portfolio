    async function refreshCartDrawer(cartData) {
      const drawer = document.querySelector('[data-cart-drawer]');
      if (!drawer) return;

      const body = drawer.querySelector('[data-cart-body]');
      const footer = drawer.querySelector('.neu-cart-footer');

