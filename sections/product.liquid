      let itemsHTML = '<ul class="neu-cart-items">';
      cartData.items.forEach(item => {
        const imageUrl = item.image
          ? item.image.replace(/(\.[^.]+)$/, '_120x$1').replace(/^\/\//, 'https://')
          : '';

        itemsHTML += `
          <li class="neu-cart-item" data-key="${item.key}">
            <div class="neu-cart-item__image">
              ${imageUrl ? `<img src="${imageUrl}" alt="${item.title.replace(/"/g, '&quot;')}">` : ''}
            </div>
            <div class="neu-cart-item__info">
              <h4 class="neu-cart-item__title">${item.product_title}</h4>
              <p class="neu-cart-item__price">${formatMoney(item.final_price)}</p>
              <div class="neu-qty">
                <button class="neu-qty__btn" data-qty-change="minus" data-key="${item.key}">−</button>
                <span class="neu-qty__value">${item.quantity}</span>
                <button class="neu-qty__btn" data-qty-change="plus" data-key="${item.key}">+</button>
              </div>
            </div>
            <button class="neu-cart-item__remove" data-remove data-key="${item.key}" aria-label="Remove item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6"></path>
              </svg>
            </button>
          </li>
        `;
      });
      itemsHTML += '</ul>';

      if (body) body.innerHTML = itemsHTML;

      const routesRoot = window.Shopify?.routes?.root || '/';
      const cartTotalFormatted = formatMoney(cartData.total_price);

      const footerHTML = `
        <div class="neu-cart-subtotal">
          <span>Subtotal</span>
          <span data-cart-total>${cartTotalFormatted}</span>
        </div>
        <a href="${routesRoot}cart" class="neu-btn neu-btn--secondary">View Cart</a>
        <a href="/checkout" class="neu-btn neu-btn--primary">Checkout</a>
      `;

      if (footer) {
        footer.innerHTML = footerHTML;
      } else {
        const newFooter = document.createElement('div');
        newFooter.className = 'neu-cart-footer';
        newFooter.innerHTML = footerHTML;
        drawer.appendChild(newFooter);
      }

      bindCartItemHandlers();
    }

    function bindCartItemHandlers() {
      const drawer = document.querySelector('[data-cart-drawer]');
      if (!drawer) return;

      drawer.querySelectorAll('[data-qty-change]').forEach(btn => {
        if (btn.dataset.bound) return;
        btn.dataset.bound = 'true';

        btn.addEventListener('click', async function() {
          const key = this.dataset.key;
          const direction = this.dataset.qtyChange;
          const valueEl = this.parentElement.querySelector('.neu-qty__value');
          let currentQty = parseInt(valueEl.textContent) || 1;

          const newQty = direction === 'plus' ? currentQty + 1 : Math.max(0, currentQty - 1);

          try {
            const res = await fetch(`${window.Shopify.routes.root}cart/change.js`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: key, quantity: newQty })
            });
            const updatedCart = await res.json();
            updateCartCounts(updatedCart.item_count);
            refreshCartDrawer(updatedCart);

            if (window.PUB_SUB_EVENTS && typeof window.publish === 'function') {
              window.publish(window.PUB_SUB_EVENTS.cartUpdate, { source: 'neumorphic-cart-drawer', cartData: updatedCart });
            }
            document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: updatedCart } }));
          } catch(err) { console.error('[Cart] Qty update failed:', err); }
        });
      });

      drawer.querySelectorAll('[data-remove]').forEach(btn => {
        if (btn.dataset.bound) return;
        btn.dataset.bound = 'true';

        btn.addEventListener('click', async function() {
          const key = this.dataset.key;
          const itemEl = this.closest('.neu-cart-item');

          if (itemEl) {
            itemEl.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
            itemEl.style.opacity = '0';
            itemEl.style.transform = 'translateX(20px)';
          }

          try {
            const res = await fetch(`${window.Shopify.routes.root}cart/change.js`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: key, quantity: 0 })
            });
            const updatedCart = await res.json();
            updateCartCounts(updatedCart.item_count);
            setTimeout(() => refreshCartDrawer(updatedCart), 250);

            if (window.PUB_SUB_EVENTS && typeof window.publish === 'function') {
              window.publish(window.PUB_SUB_EVENTS.cartUpdate, { source: 'neumorphic-cart-drawer', cartData: updatedCart });
            }
            document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: updatedCart } }));
          } catch(err) { console.error('[Cart] Remove failed:', err); }
        });
      });
    }

    bindCartItemHandlers();

    function closeCartDrawer() {
      const drawer = document.querySelector('[data-cart-drawer]');
      const overlay = document.querySelector('[data-cart-overlay]');

      if (drawer) {
        drawer.classList.remove('is-open', 'active', 'open');
        drawer.setAttribute('aria-hidden', 'true');
        drawer.removeAttribute('open');
      }
      if (overlay) {
        overlay.classList.remove('is-open', 'active', 'open');
        overlay.setAttribute('aria-hidden', 'true');
      }
      document.body.classList.remove('cart-drawer-open', 'overflow-hidden', 'no-scroll');
      document.documentElement.style.overflow = '';
    }

    document.querySelectorAll('[data-cart-close]').forEach(btn => {
      if (btn.dataset.neuBound) return;
      btn.dataset.neuBound = 'true';
      btn.addEventListener('click', closeCartDrawer);
    });

    document.querySelectorAll('[data-cart-overlay]').forEach(overlay => {
      if (overlay.dataset.neuBound) return;
      overlay.dataset.neuBound = 'true';
      overlay.addEventListener('click', closeCartDrawer);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const drawer = document.querySelector('[data-cart-drawer]');
        if (drawer && drawer.classList.contains('is-open')) closeCartDrawer();
      }
    });

    if (form && addBtn) {
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        if (addBtn.classList.contains('neu-add-to-bag--loading')) return;

        const originalText = atbText.textContent;
        addBtn.classList.add('neu-add-to-bag--loading');
        atbText.textContent = 'Adding';

        const formData = new FormData(form);

        try {
          const addResponse = await fetch(`${window.Shopify.routes.root}cart/add.js`, {
            method: 'POST',
            headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: formData
          });

          const addData = await addResponse.json();

          if (addData.status || addData.errors) {
            atbText.textContent = addData.description || 'Error';
            addBtn.classList.remove('neu-add-to-bag--loading');
            console.error('[Cart] Add error:', addData);
            setTimeout(() => { atbText.textContent = originalText; }, 2500);
            return;
          }

          const cartResponse = await fetch(`${window.Shopify.routes.root}cart.js`);
          const cartData = await cartResponse.json();

          updateCartCounts(cartData.item_count);
          await refreshCartDrawer(cartData);
          openCustomCartDrawer();

          if (window.PUB_SUB_EVENTS && typeof window.publish === 'function') {
            window.publish(window.PUB_SUB_EVENTS.cartUpdate, {
              source: 'neumorphic-product-form',
              productVariantId: variantIdInput.value,
              cartData: cartData
            });
          }
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: cartData } }));

          atbText.textContent = 'Added ✓';
          addBtn.classList.remove('neu-add-to-bag--loading');
          addBtn.classList.add('neu-add-to-bag--success');

          setTimeout(() => {
            atbText.textContent = originalText;
            addBtn.classList.remove('neu-add-to-bag--success');
          }, 2200);

        } catch (err) {
          console.error('[Cart] Add to cart failed:', err);
          atbText.textContent = 'Error';
          addBtn.classList.remove('neu-add-to-bag--loading');
          setTimeout(() => { atbText.textContent = originalText; }, 2000);
        }
      });
    }
  })();
</script>
