      const fullText = contentEl.textContent || '';
      const totalWords = countWords(fullText);

      if (totalWords <= wordLimit) {
        seeMoreBtn.hidden = true;
        return;
      }

      const fullHTML = contentEl.innerHTML;
      contentEl.setAttribute('data-full-html', fullHTML);

      const truncatedHTML = truncateToWordLimit(contentEl, wordLimit);
      contentEl.setAttribute('data-truncated-html', truncatedHTML);

      contentEl.innerHTML = truncatedHTML;
