function initOptionDrag() {
  const containers = section.querySelectorAll('.neu-option-buttons');

  containers.forEach(container => {
    if (container.dataset.dragBound) return;
    container.dataset.dragBound = 'true';

    // Detect if slider mode is needed (content overflows)
    function checkSliderMode() {
      const overflows = container.scrollWidth > container.clientWidth + 1;
      container.classList.toggle('is-slider', overflows);
      return overflows;
    }

    // Initial check + re-check on resize / font-load
    requestAnimationFrame(checkSliderMode);
    setTimeout(checkSliderMode, 100);
    setTimeout(checkSliderMode, 400);

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(checkSliderMode);
    }

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        checkSliderMode();
        if (container._updateIndicator) container._updateIndicator(false);
      }, 120);
    });

    let isDragging = false;
    let hasMoved = false;
    let startX = 0;
    let scrollStart = 0;
    let velX = 0;
    let lastX = 0;
    let lastTime = 0;
    let momentumRAF = null;

    const DRAG_THRESHOLD = 5; // px

    // ---- Mouse drag ----
    container.addEventListener('mousedown', (e) => {
      if (e.button !== 0) return;
      if (!container.classList.contains('is-slider')) return;

      isDragging = true;
      hasMoved = false;
      startX = e.pageX;
      scrollStart = container.scrollLeft;
      lastX = e.pageX;
      lastTime = Date.now();
      velX = 0;

      if (momentumRAF) {
        cancelAnimationFrame(momentumRAF);
        momentumRAF = null;
      }
    });

    document.addEventListener('mousemove', (e) => {
      if (!isDragging) return;

      const x = e.pageX;
      const dx = startX - x;

      if (!hasMoved && Math.abs(dx) > DRAG_THRESHOLD) {
        hasMoved = true;
        container.classList.add('is-dragging', 'was-dragged');
      }

      if (hasMoved) {
        container.scrollLeft = scrollStart + dx;

        const now = Date.now();
        const dt = now - lastTime;
        if (dt > 0) {
          velX = (lastX - x) / dt;
        }
        lastX = x;
        lastTime = now;

        e.preventDefault();
      }
    });

    document.addEventListener('mouseup', () => {
      if (!isDragging) return;
      isDragging = false;

      container.classList.remove('is-dragging');

      if (hasMoved) {
        // Keep was-dragged briefly so the click event about to fire is blocked
        setTimeout(() => container.classList.remove('was-dragged'), 100);

        if (Math.abs(velX) > 0.3) {
          applyMomentum(container, velX);
        }
      }

      hasMoved = false;
    });

    // Also block click on capture phase if a drag happened
    container.addEventListener('click', (e) => {
      if (container.classList.contains('was-dragged')) {
        e.stopPropagation();
        e.preventDefault();
      }
    }, true);

    // ---- Touch handling (native scroll handles movement) ----
    let touchStartX = 0;
    let touchDragDistance = 0;

    container.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0].pageX;
      touchDragDistance = 0;
    }, { passive: true });

    container.addEventListener('touchmove', (e) => {
      touchDragDistance = Math.abs(e.touches[0].pageX - touchStartX);
    }, { passive: true });

    container.addEventListener('touchend', () => {
      if (touchDragDistance > 10) {
        container.classList.add('was-dragged');
        setTimeout(() => container.classList.remove('was-dragged'), 100);
      }
    }, { passive: true });

    // ---- Momentum ----
    function applyMomentum(el, velocity) {
      const friction = 0.92;
      const minVelocity = 0.1;
      let v = velocity * 800;

      function step() {
        v *= friction;

        if (Math.abs(v) < minVelocity) {
          momentumRAF = null;
          if (container._updateIndicator) container._updateIndicator(false);
          return;
        }

        el.scrollLeft += v * 0.016;
        momentumRAF = requestAnimationFrame(step);
      }

      momentumRAF = requestAnimationFrame(step);
    }

    // Scroll active option into view on load
    requestAnimationFrame(() => {
      const active = container.querySelector('.neu-option-btn--active');
      if (active && container.classList.contains('is-slider')) {
        scrollButtonIntoView(container, active, false);
      }
    });
  });
}

