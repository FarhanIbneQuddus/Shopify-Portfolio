    /* ============================================
       SEE MORE / SEE LESS
       ============================================ */
    function countWords(text) {
      if (!text) return 0;
      return text.trim().split(/\s+/).filter(w => w.length > 0).length;
    }

    function truncateToWordLimit(contentEl, wordLimit) {
      const fullHTML = contentEl.getAttribute('data-full-html') || contentEl.innerHTML;

      if (!contentEl.hasAttribute('data-full-html')) {
        contentEl.setAttribute('data-full-html', fullHTML);
      }

      const temp = document.createElement('div');
      temp.innerHTML = fullHTML;

      let wordsUsed = 0;
      let truncated = false;

      function walk(node) {
        if (truncated) return;

        if (node.nodeType === Node.TEXT_NODE) {
          const words = node.textContent.trim().split(/\s+/).filter(w => w.length > 0);

          if (wordsUsed + words.length <= wordLimit) {
            wordsUsed += words.length;
          } else {
            const remaining = wordLimit - wordsUsed;
            if (remaining > 0) {
              node.textContent = words.slice(0, remaining).join(' ') + '…';
              wordsUsed = wordLimit;
            } else {
              node.textContent = '';
            }
            truncated = true;
            let next = node.nextSibling;
            while (next) {
              const toRemove = next;
              next = next.nextSibling;
              toRemove.remove();
            }
            let parent = node.parentNode;
            while (parent && parent !== temp) {
              let sibling = parent.nextSibling;
              while (sibling) {
                const toRemove = sibling;
                sibling = sibling.nextSibling;
                toRemove.remove();
              }
              parent = parent.parentNode;
            }
          }
        } else if (node.nodeType === Node.ELEMENT_NODE) {
          const children = Array.from(node.childNodes);
          children.forEach(child => walk(child));
        }
      }

      walk(temp);
      return temp.innerHTML;
    }

    function measureAndApplyExtension(panel) {
      const bottomPanel = section.querySelector('.neu-bottom-panel');
      const faqWrapper = section.querySelector('.neu-faq-wrapper');
      const tabsContent = section.querySelector('.neu-tabs-content');

      if (!bottomPanel || !faqWrapper || !tabsContent) return;

      if (window.matchMedia('(max-width: 768px)').matches) {
        bottomPanel.classList.remove('neu-bottom-panel--content-extended');
        bottomPanel.style.removeProperty('--faq-height');
        return;
      }

      requestAnimationFrame(() => {
        const faqHeight = faqWrapper.offsetHeight;
        const contentHeight = tabsContent.offsetHeight;

        if (contentHeight > faqHeight) {
          bottomPanel.style.setProperty('--faq-height', faqHeight + 'px');
          bottomPanel.classList.add('neu-bottom-panel--content-extended');
        } else {
          bottomPanel.classList.remove('neu-bottom-panel--content-extended');
          bottomPanel.style.removeProperty('--faq-height');
        }
