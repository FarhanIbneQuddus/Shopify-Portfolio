    function initTabsSlider(container) {
      if (!container) return;
      const indicator = container.querySelector('.neu-tabs-indicator');
      if (!indicator) return;

      const btns = container.querySelectorAll('.neu-tabs-slider__btn');

      function moveIndicator(target, animate = true) {
        if (!target) return;
        const containerRect = container.getBoundingClientRect();
        const targetRect = target.getBoundingClientRect();
        const left = targetRect.left - containerRect.left + container.scrollLeft;
        const width = targetRect.width;

        if (!animate) {
          indicator.style.transition = 'none';
          requestAnimationFrame(() => { indicator.style.transition = ''; });
        }

        indicator.style.width = width + 'px';
        indicator.style.transform = `translateX(${left}px)`;
        indicator.style.opacity = '1';
      }

      function updateIndicator(animate = true) {
        const active = container.querySelector('.neu-tabs-slider__btn.is-active');
        if (active) moveIndicator(active, animate);
        else indicator.style.opacity = '0';
      }

      btns.forEach(btn => {
        btn.addEventListener('click', function() {
          btns.forEach(b => b.classList.remove('is-active', 'neu-option-btn--active', 'neu-tab-btn--active'));
          if (this.classList.contains('neu-option-btn')) this.classList.add('neu-option-btn--active');
          if (this.classList.contains('neu-tab-btn')) this.classList.add('neu-tab-btn--active');
          this.classList.add('is-active');
          moveIndicator(this);

          scrollButtonIntoView(container, this);
        });
      });

      requestAnimationFrame(() => updateIndicator(false));

      let resizeTimer;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => updateIndicator(false), 100);
      });

      container.addEventListener('scroll', () => {
        requestAnimationFrame(() => updateIndicator(false));
