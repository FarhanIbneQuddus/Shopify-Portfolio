{% render 'neu-settings', section: section %}

{{ 'neumorphic-product.css' | asset_url | stylesheet_tag }}

{%- assign product = section.settings.product | default: product -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign featured_image = current_variant.featured_image | default: product.featured_image -%}

<div
  class="neu-product-section"
  data-section-id="{{ section.id }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-currency-symbol="{{ cart.currency.symbol | escape }}"
  data-currency-code="{{ cart.currency.iso_code }}"
  style="padding-top: {{ section.settings.section_padding_top }}px; padding-bottom: {{ section.settings.section_padding_bottom }}px;"
>
  <div class="neu-product-wrapper">

    {%- comment -%} TOP GRID {%- endcomment -%}
    <div class="neu-product-top">
      {%- comment -%} LEFT — GALLERY {%- endcomment -%}
      <div class="neu-product-gallery">
        <div class="neu-main-image-wrapper">
          <div class="neu-main-image">
            <div class="neu-main-image-inner">
              {%- if featured_image -%}
                <img
                  src="{{ featured_image | image_url: width: 800 }}"
                  alt="{{ featured_image.alt | escape }}"
                  loading="lazy"
                  id="neu-product-featured-img"
                  class="neu-featured-img"
                >
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'neu-placeholder-svg' }}
              {%- endif -%}
            </div>
          </div>
        </div>

        {%- if product.images.size > 1 -%}
          <div class="neu-thumbnail-container">
            <button type="button" class="neu-thumb-arrow neu-thumb-arrow--prev" aria-label="Previous image" data-thumb-direction="prev" hidden>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"/>
              </svg>
            </button>

            <div class="neu-thumbnail-row" data-thumbnail-row>
              {%- for image in product.images -%}
                <button
                  class="neu-thumbnail{% if image == featured_image %} neu-thumbnail--active{% endif %}"
                  data-image-url="{{ image | image_url: width: 800 }}"
                  data-image-alt="{{ image.alt | escape }}"
                  data-index="{{ forloop.index0 }}"
                  aria-label="Load image {{ forloop.index }}"
                  type="button"
                >
                  <img
                    src="{{ image | image_url: width: 200 }}"
                    alt="{{ image.alt | escape }}"
                    loading="lazy"
                  >
                </button>
              {%- endfor -%}
            </div>

            <button type="button" class="neu-thumb-arrow neu-thumb-arrow--next" aria-label="Next image" data-thumb-direction="next" hidden>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </button>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} RIGHT — PRODUCT INFO {%- endcomment -%}
      <div class="neu-product-info">
        {%- if section.settings.subtitle != blank -%}
          <p class="neu-product-subtitle">{{ section.settings.subtitle }}</p>
        {%- elsif product.type != blank -%}
          <p class="neu-product-subtitle">{{ product.type | upcase }}</p>
        {%- endif -%}

        <h1 class="neu-product-title">{{ product.title }}</h1>

        {%- if section.settings.tagline != blank -%}
          <p class="neu-product-tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}

        <div class="neu-product-meta-row">
          <div class="neu-badge-pill neu-reviews-pill">
            <div class="neu-stars">
              {%- assign rating = section.settings.rating | default: 5 -%}
              {%- for i in (1..5) -%}
                <svg class="neu-star{% if i <= rating %} neu-star--filled{% endif %}" width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              {%- endfor -%}
            </div>
            <span class="neu-review-count">{{ section.settings.review_count | default: '0' }} REVIEWS</span>
          </div>
          <div class="neu-badge-pill neu-stock-pill">
            <span class="neu-stock-dot"></span>
            <span class="neu-stock-text">
              {%- if current_variant.available -%}IN STOCK{%- else -%}SOLD OUT{%- endif -%}
            </span>
          </div>
        </div>

        <div class="neu-price-row">
          <span class="neu-price" id="neu-product-price">{{ current_variant.price | money_without_trailing_zeros }}</span>
          {%- if section.settings.installment_count > 0 -%}
            <span class="neu-installment">
              or {{ section.settings.installment_count }} × {{ current_variant.price | divided_by: section.settings.installment_count | money_without_trailing_zeros }}
            </span>
          {%- endif -%}
        </div>

        {%- form 'product', product, id: 'neu-product-form', class: 'neu-product-form', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" id="neu-variant-id">

          {%- for option in product.options_with_values -%}
            <div class="neu-option-group">
              <label class="neu-option-label">{{ option.name | upcase }}</label>
              <div class="neu-option-buttons neu-tabs-slider" data-option-index="{{ forloop.index0 }}">
                <span class="neu-tabs-indicator" aria-hidden="true"></span>
                {%- for value in option.values -%}
                  <button
                    type="button"
                    class="neu-option-btn neu-tabs-slider__btn{% if option.selected_value == value %} neu-option-btn--active is-active{% endif %}"
                    data-value="{{ value }}"
                    data-option-position="{{ option.position }}"
                    aria-label="{{ option.name }}: {{ value }}"
                  >
                    {{ value }}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}

          <div class="neu-action-row">
            <div class="neu-quantity-selector">
              <button type="button" class="neu-qty-btn" data-action="decrease" aria-label="Decrease quantity">
                <svg width="10" height="2" viewBox="0 0 10 2" fill="none"><rect width="10" height="2" rx="1" fill="currentColor"/></svg>
              </button>
              <input
                type="number"
                name="quantity"
                id="neu-quantity"
                class="neu-qty-input"
                value="1"
                min="1"
                aria-label="Quantity"
              >
              <button type="button" class="neu-qty-btn" data-action="increase" aria-label="Increase quantity">
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><rect x="4" width="2" height="10" rx="1" fill="currentColor"/><rect y="4" width="10" height="2" rx="1" fill="currentColor"/></svg>
              </button>
            </div>

            <button
              type="submit"
              class="neu-add-to-bag"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
                <line x1="3" y1="6" x2="21" y2="6"/>
                <path d="M16 10a4 4 0 01-8 0"/>
              </svg>
              <span class="neu-atb-text">{%- if current_variant.available -%}Add to Bag{%- else -%}Sold Out{%- endif -%}</span>
              <span class="neu-atb-spinner" aria-hidden="true"></span>
            </button>
          </div>
        {%- endform -%}

        <div class="neu-trust-badges">
          {%- assign trust_blocks = section.blocks | where: 'type', 'trust_badge' -%}
          {%- if trust_blocks.size > 0 -%}
            {%- for block in trust_blocks -%}
              <div class="neu-trust-badge" {{ block.shopify_attributes }}>
                <div class="neu-trust-icon">
                  {%- case block.settings.icon -%}
                    {%- when 'shipping' -%}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                    {%- when 'returns' -%}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg>
                    {%- when 'warranty' -%}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    {%- when 'secure' -%}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                    {%- else -%}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/></svg>
                  {%- endcase -%}
                </div>
                <span class="neu-trust-text">{{ block.settings.text }}</span>
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="neu-trust-badge">
              <div class="neu-trust-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></div>
              <span class="neu-trust-text">Free shipping</span>
            </div>
            <div class="neu-trust-badge">
              <div class="neu-trust-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg></div>
              <span class="neu-trust-text">30-day returns</span>
            </div>
            <div class="neu-trust-badge">
              <div class="neu-trust-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
              <span class="neu-trust-text">3-year warranty</span>
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} USUALLY BOUGHT TOGETHER {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'usually_bought_together' -%}
            {% render 'bought-together', block: block, product: product %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} BOTTOM — TABS + FAQ {%- endcomment -%}
    <div class="neu-product-bottom">
      <div class="neu-tabs-nav neu-tabs-slider">
        <span class="neu-tabs-indicator" aria-hidden="true"></span>
        {%- assign tab_blocks = section.blocks | where: 'type', 'tab' -%}
        {%- if tab_blocks.size > 0 -%}
          {%- for block in tab_blocks -%}
            <button
              type="button"
              class="neu-tab-btn neu-tabs-slider__btn{% if forloop.first %} neu-tab-btn--active is-active{% endif %}"
              data-tab="{{ block.id }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.tab_title }}
            </button>
          {%- endfor -%}
        {%- else -%}
          <button type="button" class="neu-tab-btn neu-tabs-slider__btn neu-tab-btn--active is-active" data-tab="overview">Overview</button>
          <button type="button" class="neu-tab-btn neu-tabs-slider__btn" data-tab="specifications">Specifications</button>
          <button type="button" class="neu-tab-btn neu-tabs-slider__btn" data-tab="shipping">Shipping</button>
        {%- endif -%}
      </div>

      <div class="neu-bottom-panel">
        <div class="neu-tabs-content">
          {%- if tab_blocks.size > 0 -%}
            {%- for block in tab_blocks -%}
              {%- assign word_limit = block.settings.word_limit | default: 0 -%}
              <div
                class="neu-tab-panel{% if forloop.first %} neu-tab-panel--active{% endif %}"
                data-tab-panel="{{ block.id }}"
                data-word-limit="{{ word_limit }}"
              >
                <div class="neu-tab-panel__content" data-tab-content>
                  {%- assign content_source = block.settings.content_source | default: 'custom' -%}

                  {%- case content_source -%}
                    {%- when 'product_description' -%}
                      {%- if product.description != blank -%}
                        {{ product.description }}
                      {%- else -%}
                        <p>No description available.</p>
                      {%- endif -%}

                    {%- when 'metafield' -%}
                      {%- assign metafield_namespace = block.settings.metafield_namespace | default: 'custom' -%}
                      {%- assign metafield_key = block.settings.metafield_key -%}
                      {%- if metafield_key != blank -%}
                        {%- assign metafield_value = product.metafields[metafield_namespace][metafield_key] -%}
                        {%- if metafield_value != blank -%}
                          {%- if metafield_value.type == 'rich_text_field' -%}
                            {{ metafield_value | metafield_tag }}
                          {%- elsif metafield_value.value.size > 0 and metafield_value.value.first -%}
                            {{ metafield_value | metafield_tag }}
                          {%- else -%}
                            <div class="neu-metafield-content">{{ metafield_value }}</div>
                          {%- endif -%}
                        {%- else -%}
                          <p class="neu-metafield-empty">No content found for metafield <code>{{ metafield_namespace }}.{{ metafield_key }}</code></p>
                        {%- endif -%}
                      {%- else -%}
                        <p class="neu-metafield-empty">Please set a metafield key in the block settings.</p>
                      {%- endif -%}

                    {%- else -%}
                      {%- if block.settings.tab_content != blank -%}
                        {{ block.settings.tab_content }}
                      {%- else -%}
                        <p>No content added yet.</p>
                      {%- endif -%}
                  {%- endcase -%}
                </div>

                {%- if word_limit > 0 -%}
                  <button type="button" class="neu-see-more-btn" data-see-more hidden>
                    <span class="neu-see-more-btn__text">See more</span>
                    <svg class="neu-see-more-btn__icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="6 9 12 15 18 9"/>
                    </svg>
                  </button>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="neu-tab-panel neu-tab-panel--active" data-tab-panel="overview" data-word-limit="{{ section.settings.default_word_limit | default: 0 }}">
              <div class="neu-tab-panel__content" data-tab-content>
                {%- if product.description != blank -%}
                  {{ product.description }}
                {%- else -%}
                  <p>No description available for this product.</p>
                {%- endif -%}
              </div>
              {%- if section.settings.default_word_limit > 0 -%}
                <button type="button" class="neu-see-more-btn" data-see-more hidden>
                  <span class="neu-see-more-btn__text">See more</span>
                  <svg class="neu-see-more-btn__icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"/>
                  </svg>
                </button>
              {%- endif -%}
            </div>
            <div class="neu-tab-panel" data-tab-panel="specifications" data-word-limit="{{ section.settings.default_word_limit | default: 0 }}">
              <div class="neu-tab-panel__content" data-tab-content>
                {%- assign specs_metafield = product.metafields.custom.specifications -%}
                {%- if specs_metafield != blank -%}
                  {{ specs_metafield | metafield_tag }}
                {%- else -%}
                  <p>Product specifications will appear here. Add a metafield <code>custom.specifications</code> to your product to populate this section.</p>
                {%- endif -%}
              </div>
              {%- if section.settings.default_word_limit > 0 -%}
                <button type="button" class="neu-see-more-btn" data-see-more hidden>
                  <span class="neu-see-more-btn__text">See more</span>
                  <svg class="neu-see-more-btn__icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"/>
                  </svg>
                </button>
              {%- endif -%}
            </div>
            <div class="neu-tab-panel" data-tab-panel="shipping" data-word-limit="{{ section.settings.default_word_limit | default: 0 }}">
              <div class="neu-tab-panel__content" data-tab-content>
                {%- assign shipping_metafield = product.metafields.custom.shipping -%}
                {%- if shipping_metafield != blank -%}
                  {{ shipping_metafield | metafield_tag }}
                {%- else -%}
                  <p>Shipping information will appear here. Add a metafield <code>custom.shipping</code> to your product to populate this section.</p>
                {%- endif -%}
              </div>
              {%- if section.settings.default_word_limit > 0 -%}
                <button type="button" class="neu-see-more-btn" data-see-more hidden>
                  <span class="neu-see-more-btn__text">See more</span>
                  <svg class="neu-see-more-btn__icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"/>
                  </svg>
                </button>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} FAQ ACCORDION {%- endcomment -%}
        {%- assign faq_blocks = section.blocks | where: 'type', 'faq_item' -%}
        <div class="neu-faq-wrapper">
          {%- if section.settings.faq_heading != blank -%}
            <h3 class="neu-faq-heading">{{ section.settings.faq_heading }}</h3>
          {%- endif -%}

          <div class="neu-faq-list">
            {%- if faq_blocks.size > 0 -%}
              {%- for block in faq_blocks -%}
                <div class="neu-faq-item" {{ block.shopify_attributes }}>
                  <button type="button" class="neu-faq-question" aria-expanded="false" aria-controls="faq-answer-{{ block.id }}">
                    <span class="neu-faq-q-text">{{ block.settings.question }}</span>
                    <span class="neu-faq-icon" aria-hidden="true">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"/>
                      </svg>
                    </span>
                  </button>
                  <div class="neu-faq-answer" id="faq-answer-{{ block.id }}" role="region">
                    <div class="neu-faq-answer-inner">
                      {{ block.settings.answer }}
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            {%- else -%}
              {%- assign default_faqs = 'What materials is it made of?|A precision-milled aluminum chassis with a soft-touch polymer shell for grip and durability.,How long does the battery last?|Up to 14 hours of active use on a single charge, with fast USB-C top-ups in under 45 minutes.,Is it water resistant?|Yes — rated IP54 for dust and splash resistance. Not suitable for full submersion.,What is the warranty coverage?|Every unit ships with a 3-year limited warranty covering defects and normal wear.,How do I set it up?|Unbox, power on, and follow the guided companion app — most people are running in under 3 minutes.,Does it work offline?|Absolutely. Core functions run on-device with no cloud dependency required.,Can I use it with iOS and Android?|Yes — full parity across iOS 15+ and Android 11+ through our free companion app.,What is your return policy?|30 days, no questions asked. We provide a prepaid label and issue refunds within 5 business days of receipt.,How is it shipped?|Free carbon-neutral shipping via express carriers, typically arriving in 2–4 business days.,Do you offer bulk or team pricing?|Yes — reach out to our team for volume discounts on orders of 10+ units.' | split: ',' -%}

              {%- for faq in default_faqs -%}
                {%- assign parts = faq | split: '|' -%}
                <div class="neu-faq-item">
                  <button type="button" class="neu-faq-question" aria-expanded="false" aria-controls="faq-answer-default-{{ forloop.index }}">
                    <span class="neu-faq-q-text">{{ parts[0] }}</span>
                    <span class="neu-faq-icon" aria-hidden="true">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"/>
                      </svg>
                    </span>
                  </button>
                  <div class="neu-faq-answer" id="faq-answer-default-{{ forloop.index }}" role="region">
                    <div class="neu-faq-answer-inner">
                      <p>{{ parts[1] }}</p>
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" id="neu-product-variants-{{ section.id }}">
    {{ product.variants | json }}
  </script>
</div>

<script>
  (function() {
    const sectionId = '{{ section.id }}';
    const section = document.querySelector(`[data-section-id="${sectionId}"]`);
    if (!section) return;

    /* ============================================
       MONEY FORMATTING
       ============================================ */
    const moneyFormat = section.dataset.moneyFormat || '${{amount}}';

    function formatMoney(cents, format) {
      if (typeof cents === 'string') cents = cents.replace('.', '');
      const value = parseFloat(cents);
      if (isNaN(value)) return cents;

      const formatString = format || moneyFormat;
      const placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;

      function formatWithDelimiters(number, precision = 2, thousands = ',', decimal = '.') {
        if (isNaN(number) || number == null) return 0;
        number = (number / 100.0).toFixed(precision);
        const parts = number.split('.');
        const dollarsAmount = parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands);
        const centsAmount = parts[1] ? decimal + parts[1] : '';
        return dollarsAmount + centsAmount;
      }

      let formatted = formatString;
      const match = formatString.match(placeholderRegex);
      if (!match) return formatString;

      switch (match[1]) {
        case 'amount':
          formatted = formatString.replace(placeholderRegex, formatWithDelimiters(value, 2));
          break;
        case 'amount_no_decimals':
          formatted = formatString.replace(placeholderRegex, formatWithDelimiters(value, 0));
          break;
        case 'amount_with_comma_separator':
          formatted = formatString.replace(placeholderRegex, formatWithDelimiters(value, 2, '.', ','));
          break;
        case 'amount_no_decimals_with_comma_separator':
          formatted = formatString.replace(placeholderRegex, formatWithDelimiters(value, 0, '.', ','));
          break;
        case 'amount_with_space_separator':
          formatted = formatString.replace(placeholderRegex, formatWithDelimiters(value, 2, ' ', '.'));
          break;
        case 'amount_no_decimals_with_space_separator':
          formatted = formatString.replace(placeholderRegex, formatWithDelimiters(value, 0, ' ', '.'));
          break;
        case 'amount_with_apostrophe_separator':
          formatted = formatString.replace(placeholderRegex, formatWithDelimiters(value, 2, "'", '.'));
          break;
      }

      return formatted;
    }

    function formatMoneyNoTrailingZeros(cents) {
      const formatted = formatMoney(cents);
      return formatted.replace(/([.,])00(\D|$)/, '$2');
    }

    /* ============================================
       OPTION BUTTONS — Draggable when overflowing
       ============================================ */
    function scrollButtonIntoView(container, button, smooth = true) {
      if (!container || !button) return;

      const containerRect = container.getBoundingClientRect();
      const buttonRect = button.getBoundingClientRect();

      const overflowLeft = containerRect.left - buttonRect.left;
      const overflowRight = buttonRect.right - containerRect.right;

      if (overflowLeft > 0) {
        container.scrollBy({
          left: -overflowLeft - 20,
          behavior: smooth ? 'smooth' : 'auto'
        });
      } else if (overflowRight > 0) {
        container.scrollBy({
          left: overflowRight + 20,
          behavior: smooth ? 'smooth' : 'auto'
        });
      }
    }

