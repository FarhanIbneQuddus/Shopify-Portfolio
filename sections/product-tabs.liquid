{% render 'neu-settings', section: section %}
<style>
  /* ============================================
   BASE SECTION
   ============================================ */
.section-product-tabs-catalogue {
  background: var(--neu-bg);
  padding: 60px 0;
  font-family: inherit;
  overflow-x: clip;
}

.page-width {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 !important;
}

.catalogue-section {
  color: var(--neu-text);
}

/* ============================================
   HEADER
   ============================================ */
.catalogue-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 24px;
  margin-bottom: 32px;
  flex-wrap: wrap;
}

@media (max-width: 749px) {
  .catalogue-header {
    padding: 0 24px;
  }
}

.catalogue-subheading {
  font-size: 13px;
  letter-spacing: 0.18em;
  color: var(--neu-text-muted);
  margin: 0 0 8px;
  text-transform: uppercase;
  font-weight: 500;
}

.catalogue-heading {
  font-size: clamp(40px, 6vw, 72px);
  font-weight: 400;
  margin: 0;
  line-height: 1;
  letter-spacing: -0.02em;
  color: var(--neu-text);
}

/* ============================================
   TABS
   ============================================ */
.catalogue-tabs {
  position: relative;
  display: inline-flex;
  padding: 6px;
  background: var(--neu-bg);
  border-radius: 999px;
  box-shadow: var(--shadow-neu-in-sm);
  gap: 0;
  isolation: isolate;
  max-width: 100%;
  overflow-x: auto;
  overflow-y: hidden;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
  scroll-behavior: smooth;
  overscroll-behavior-x: contain;
}

.catalogue-tabs::-webkit-scrollbar { display: none; }

.catalogue-tabs-indicator {
  position: absolute;
  top: 6px;
  height: calc(100% - 12px);
  left: 0;
  width: 0;
  background: var(--neu-bg);
  border-radius: 999px;
  box-shadow: var(--neu-shadow-strong);
  transition:
    transform 0.45s cubic-bezier(0.65, 0, 0.35, 1),
    width 0.45s cubic-bezier(0.65, 0, 0.35, 1),
    opacity 0.25s ease;
  z-index: 0;
  pointer-events: none;
  transform: translateX(0);
  opacity: 0;
}

.catalogue-tabs-indicator.is-ready {
  opacity: 1;
}

.catalogue-tab {
  position: relative;
  z-index: 1;
  background: transparent;
  border: none;
  padding: 12px 24px;
  font-size: 14px;
  font-weight: 500;
  color: var(--neu-text-muted);
  cursor: pointer;
  border-radius: 999px;
  transition: color 0.3s ease;
  white-space: nowrap;
  font-family: inherit;
  line-height: 1;
  outline: none;
  flex-shrink: 0;
}

.catalogue-tab:hover {
  color: var(--neu-text);
}

.catalogue-tab.is-active {
  color: var(--neu-text);
}

.catalogue-tab:focus-visible {
  outline: 2px solid var(--neu-accent);
  outline-offset: 2px;
}

/* ============================================
   PANELS
   ============================================ */
.catalogue-panel {
  display: none;
}

.catalogue-panel.is-active {
  display: block;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ============================================
   SLIDER
   ============================================ */
.catalogue-slider-wrap {
  position: relative;
  padding: 20px 0;
  margin: 0 -12px;
}

.catalogue-track {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: calc((100% - (var(--cards-per-row) - 1) * 24px) / var(--cards-per-row));
  gap: 24px;
  padding: 52px;
  overflow-x: auto;
  overflow-y: hidden;
  scrollbar-width: none;
  -ms-overflow-style: none;
  cursor: default;
  user-select: none;
  -webkit-user-select: none;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior-x: contain;
  touch-action: pan-x;
  scroll-behavior: smooth;
}

.catalogue-track::-webkit-scrollbar { display: none; }

/* Grab cursor only when actually scrollable (set by JS) */
.catalogue-slider-wrap.is-scrollable .catalogue-track {
  cursor: grab;
}

.catalogue-track.is-grabbing {
  cursor: grabbing;
  scroll-behavior: auto;
}

/* When only 1 product exists — no slider markup */
.catalogue-slider-wrap:not(.has-slider) .catalogue-track {
  overflow: visible;
  cursor: default;
}

/* Arrows */
.catalogue-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background: var(--neu-bg);
  border: none;
  box-shadow: var(--shadow-neu-out-sm);
  color: var(--neu-text);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: color 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
  padding: 0;
}

.catalogue-arrow:hover:not([disabled]) {
  color: var(--neu-accent);
}

.catalogue-arrow:active:not([disabled]) {
  box-shadow: var(--shadow-neu-in-sm);
}

.catalogue-arrow--prev { left: 10px; }
.catalogue-arrow--next { right: 10px; }

.catalogue-arrow[disabled] {
  opacity: 0.35;
  cursor: not-allowed;
}


/* ============================================
   RESPONSIVE
   ============================================ */
@media (max-width: 1200px) {
  .section-product-tabs-catalogue { padding: 50px 0; }
  .catalogue-heading { font-size: clamp(38px, 5.5vw, 60px); }
  .catalogue-track { padding: 20px 40px; }
}

@media (max-width: 989px) {
  .section-product-tabs-catalogue { padding: 44px 0; }

  .catalogue-header {
    align-items: flex-start;
    gap: 20px;
    padding: 0 20px;
  }

  .catalogue-heading { font-size: clamp(36px, 6vw, 52px); }

  .catalogue-track {
    grid-auto-columns: calc((100% - 60px) / 2);
    gap: 20px;
    padding: 20px 32px;
  }

  .catalogue-tab { padding: 10px 20px; font-size: 13px; }

  .catalogue-arrow { width: 42px; height: 42px; }
  .catalogue-arrow--prev { left: 4px; }
  .catalogue-arrow--next { right: 4px; }
}

@media (max-width: 749px) {
  .section-product-tabs-catalogue { padding: 36px 0; }

  .catalogue-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    margin-bottom: 24px;
    padding: 0 16px;
  }

  .catalogue-subheading {
    font-size: 11px;
    letter-spacing: 0.16em;
    margin-bottom: 6px;
  }

  .catalogue-heading {
    font-size: clamp(34px, 9vw, 44px);
    line-height: 1.05;
  }

  .catalogue-tabs {
    width: 100%;
    padding: 5px;
    justify-content: flex-start;
  }

  .catalogue-tab { padding: 10px 18px; font-size: 13px; }

  .catalogue-tabs-indicator {
    top: 5px;
    height: calc(100% - 10px);
    box-shadow: var(--neu-shadow-strong);
  }

  .catalogue-slider-wrap {
    padding: 12px 0;
    margin: 0 -8px;
  }

  .catalogue-track {
    grid-auto-columns: 72%;
    gap: 16px;
    padding: 16px 16px;
  }

  .catalogue-arrow { display: none; }




}

@media (max-width: 550px) {
  .section-product-tabs-catalogue { padding: 30px 0; }
  .catalogue-header { padding: 0 14px; }
  .catalogue-heading { font-size: clamp(30px, 9.5vw, 40px); }

  .catalogue-track {
    grid-auto-columns: 82%;
    gap: 14px;
    padding: 14px 28px;
  }

  .catalogue-tab { padding: 9px 16px; font-size: 12.5px; }


}

@media (max-width: 380px) {
  .catalogue-heading { font-size: 30px; }
  .catalogue-track { grid-auto-columns: 86%; }

}

@media (max-height: 500px) and (orientation: landscape) {
  .section-product-tabs-catalogue { padding: 24px 0; }
  .catalogue-heading { font-size: 32px; }
  .catalogue-track { grid-auto-columns: 45%; }
}


</style>
<script src="{{ 'section-product-tabs-catalogue.js' | asset_url }}" defer="defer"></script>

<div class="catalogue-section" data-catalogue-section style="--cards-per-row: {{ section.settings.cards_per_row }};">
  <div class="page-width">
    <div class="catalogue-header">
      <div class="catalogue-title-wrap">
        {%- if section.settings.subheading != blank -%}
          <p class="catalogue-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="catalogue-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="catalogue-tabs" role="tablist" data-catalogue-tabs>
          <span class="catalogue-tabs-indicator" aria-hidden="true" data-tab-indicator></span>
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="catalogue-tab {% if forloop.first %}is-active{% endif %}"
              role="tab"
              data-tab-id="{{ block.id }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              <span class="catalogue-tab__label">{{ block.settings.tab_label }}</span>
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="catalogue-panels">
      {%- for block in section.blocks -%}
        {%- assign collection = collections[block.settings.collection] -%}
        {%- assign products = collection.products -%}
        {%- assign products_count = products.size -%}

        <div
          class="catalogue-panel {% if forloop.first %}is-active{% endif %}"
          data-tab-panel="{{ block.id }}"
          role="tabpanel"
        >
          {%- if products_count > 0 -%}
            <div class="catalogue-slider-wrap {% if products_count > 1 %}has-slider{% endif %}" data-slider-wrap>
              {%- if products_count > 1 -%}
                <button class="catalogue-arrow catalogue-arrow--prev" type="button" aria-label="Previous" data-arrow-prev>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <button class="catalogue-arrow catalogue-arrow--next" type="button" aria-label="Next" data-arrow-next>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              {%- endif -%}

              <div class="catalogue-track" data-slider-track>
                {%- for product in products -%}
                  {%- render 'card-product', product: product, cards_per_row: section.settings.cards_per_row -%}
                {%- endfor -%}
              </div>
            </div>
          {%- else -%}
            <p class="catalogue-empty">No products found in this collection.</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Tabs",
  "tag": "section",
  "class": "section-product-tabs-catalogue",
  "settings": [
    {
      "type": "header",
      "content": "🎨 Neumorphic Colors"
    },
    {
      "type": "color",
      "id": "neu_bg",
      "label": "Background",
      "default": "#e6e9ee"
    },
    {
      "type": "color",
      "id": "neu_shadow_dark",
      "label": "Shadow Dark",
      "default": "#4f4e4e"
    },
    {
      "type": "color",
      "id": "neu_shadow_light",
      "label": "Shadow Light",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "neu_text",
      "label": "Text Color",
      "default": "#2c3e50"
    },
    {
      "type": "color",
      "id": "neu_text_muted",
      "label": "Muted Text",
      "default": "#8b95a3"
    },
    {
      "type": "color",
      "id": "neu_accent",
      "label": "Accent",
      "default": "#7d3fbf"
    },
    
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Catalogue"
    },
    {
      "type": "range",
      "id": "cards_per_row",
      "label": "Cards per row",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_label",
          "label": "Tab label",
          "default": "All"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Tabs",
      "blocks": [
        { "type": "tab", "settings": { "tab_label": "All" } },
        { "type": "tab", "settings": { "tab_label": "Humanoid" } },
        { "type": "tab", "settings": { "tab_label": "Home" } },
        { "type": "tab", "settings": { "tab_label": "Aerial" } },
        { "type": "tab", "settings": { "tab_label": "Industrial" } }
      ]
    }
  ]
}
{% endschema %}