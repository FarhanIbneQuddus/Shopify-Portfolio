{% render 'neu-settings', section: section %}

{% comment %}
  This section is used in the search template to render search results for
  products, articles, and pages.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/search
{% endcomment %}

<section class="search-neu">
  <div class="search-neu__inner">
    <h1 class="search-neu__title">{{ 'search.title' | t }}</h1>

    <form class="search-form-neu" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="SearchTemplateInput">
        {{ 'search.placeholder' | t }}
      </label>

      <input
        class="search-form-neu__input"
        id="SearchTemplateInput"
        type="search"
        size="50"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
      >

      <button class="search-form-neu__button" type="submit">
        {{ 'search.submit' | t }}
      </button>
    </form>

    {% if search.performed %}
      {% if search.results_count == 0 %}
        <p class="search-neu__status search-neu__status--empty">
          {{ 'search.no_results_html' | t: terms: search.terms }}
        </p>
      {% else %}
        <p class="search-neu__status search-neu__status--results">
          {{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}
        </p>

        {% paginate search.results by 20 %}
          <div class="search-results">
            {% for result in search.results %}
              {% if result.object_type == 'product' %}
                <div class="search-results__card-wrapper">
                  {% render 'card-product', product: result %}
                </div>

              {% else %}
                <article class="search-result">
                  {% assign featured_image = result.featured_image | default: result.image %}

                  {% if featured_image %}
                    <div class="search-result__media">
                      {% render 'image',
                        class: 'search-result__image',
                        image: featured_image,
                        url: result.url,
                        width: 400
                      %}
                    </div>
                  {% endif %}

                  <div class="search-result__content">
                    <span class="search-result__badge">
                      {{ result.object_type }}
                    </span>

                    <div class="search-result__title">
                      {{ result.title | link_to: result.url }}
                    </div>

                    {% if result.content != blank %}
                      <p class="search-result__excerpt">
                        {{ result.content | strip_html | truncatewords: 20 }}
                      </p>
                    {% endif %}
                  </div>
                </article>
              {% endif %}
            {% endfor %}

            <div class="search-results__pagination">
              {{ paginate | default_pagination }}
            </div>
          </div>
        {% endpaginate %}
      {% endif %}
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .visually-hidden {
    position: absolute !important;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .search-neu {
    padding: 40px 0px;
  }

  .search-neu__inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: clamp(1.5rem, 3vw, 2.75rem);
    border-radius: var(--neu-radius-xl);
    background: linear-gradient(145deg, #edf2f6, #e2e8ee);
    box-shadow: var(--neu-shadow-strong);
  }

  .search-neu__title {
    margin: 0 0 1.5rem;
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--neu-text);
    text-shadow: 1px 1px 0 #fff;
  }

  /* ── Search form ── */
  .search-form-neu {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    padding: 1rem;
    border-radius: calc(var(--neu-radius-xl) - 4px);
    background: linear-gradient(145deg, #ebf0f4, #e4e9ef);
    box-shadow: var(--neu-shadow-strong);
  }

  .search-form-neu__input,
  .search-form-neu__button {
    appearance: none;
    -webkit-appearance: none;
    border: 0;
    font: inherit;
    transition: box-shadow 0.25s ease, transform 0.25s ease,
      color 0.25s ease, background 0.25s ease;
  }

  .search-form-neu__input {
    width: 100%;
    min-height: 58px;
    padding: 0 1.25rem;
    border-radius: var(--neu-radius-md);
    color: var(--neu-text);
    background: var(--neu-bg);
    box-shadow: var(--shadow-neu-in);
  }

  .search-form-neu__input::placeholder {
    color: var(--neu-text-muted);
  }

  .search-form-neu__input:focus-visible {
    outline: none;
    box-shadow: var(--shadow-neu-in), 0 0 0 3px rgba(141, 114, 183, 0.18);
  }

  .search-form-neu__button {
    min-height: 58px;
    padding: 0 1.5rem;
    border-radius: var(--neu-radius-md);
    cursor: pointer;
    font-weight: 600;
    color: #fff;
    background: linear-gradient(145deg, #9a80c3, #7b61a5);
    box-shadow: var(--shadow-neu-accent);
  }

  .search-form-neu__button:hover {
    transform: translateY(-1px);
  }

  .search-form-neu__button:active {
    transform: translateY(1px);
    box-shadow: var(--shadow-neu-in-sm);
  }

  .search-form-neu__button:focus-visible {
    outline: none;
    box-shadow: var(--shadow-neu-accent), 0 0 0 3px rgba(141, 114, 183, 0.18);
  }

  /* ── Status message ── */
  .search-neu__status {
    margin: 1.5rem 0 0;
    padding: 1rem 1.25rem;
    border-radius: var(--neu-radius-lg);
    color: var(--neu-text);
    background: linear-gradient(145deg, #edf2f6, #e3e9ef);
    box-shadow: var(--neu-shadow-strong);
    text-align: center;
  }

  .search-neu__status strong,
  .search-neu__status a {
    color: var(--neu-accent-dark);
  }

  /* ── Results grid ── */
  .search-results {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-top: 1.75rem;
  }

  /* ── Article / Page fallback card ── */
  .search-result {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    padding: 1rem;
    border-radius: var(--neu-radius-lg);
    background: linear-gradient(145deg, #edf2f6, #e2e8ee);
    box-shadow: var(--shadow-neu-out-sm);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .search-result:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-neu-accent);
  }

  .search-result__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    padding: 0.75rem;
    border-radius: calc(var(--neu-radius-lg) - 2px);
    background: linear-gradient(145deg, #eef3f7, #dde4eb);
    box-shadow: var(--shadow-neu-in-sm);
  }

  .search-result__media > * {
    display: block;
    width: 100%;
    height: 100%;
  }

  .search-result__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--neu-radius-md);
  }

  .search-result__content {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1rem;
    border-radius: var(--neu-radius-md);
    background: rgba(255, 255, 255, 0.18);
    box-shadow: var(--shadow-neu-in-sm);
  }

  .search-result__badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: var(--neu-radius-sm);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--neu-accent-dark);
    background: linear-gradient(145deg, #edf2f6, #e2e8ee);
    box-shadow: var(--shadow-neu-out-sm);
    align-self: flex-start;
  }

  .search-result__title a {
    color: var(--neu-text);
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
  }

  .search-result__title a:hover {
    color: var(--neu-accent-dark);
  }

  .search-result__excerpt {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--neu-text-muted);
  }

  /* ── Pagination ── */
  .search-results__pagination {
    grid-column: 1 / -1;
    margin-top: 0.5rem;
  }

  .search-results__pagination nav,
  .search-results__pagination [role="navigation"] {
    display: flex;
    justify-content: center;
  }

  .search-results__pagination ul,
  .search-results__pagination ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .search-results__pagination .prev,
  .search-results__pagination .page,
  .search-results__pagination .next {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 48px;
    min-height: 48px;
    padding: 0.65rem 0.95rem;
    border-radius: 16px;
    background: linear-gradient(145deg, #edf2f6, #e2e8ee);
    box-shadow: var(--shadow-neu-out-sm);
    color: var(--neu-text);
    transition: box-shadow 0.25s ease, color 0.25s ease;
  }

  .search-results__pagination .current,
  .search-results__pagination .page.current {
    color: var(--neu-accent-dark);
    box-shadow: var(--shadow-neu-in-sm);
  }

  .search-results__pagination a {
    color: inherit;
    text-decoration: none;
  }

  .search-results__pagination a:hover {
    color: var(--neu-accent-dark);
  }

  /* ── Mobile ── */
  @media screen and (max-width: 749px) {
    .search-form-neu {
      grid-template-columns: 1fr;
    }

    .search-form-neu__button {
      width: 100%;
    }

    .search-results {
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
  }

  @media screen and (max-width: 449px) {
    .search-results {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": [
    {
      "type": "header",
      "content": "Neuromatic Colors"
    },
    {
      "type": "color",
      "id": "neu_bg",
      "label": "Background",
      "default": "#e6e9ee"
    },
    {
      "type": "color",
      "id": "neu_shadow_dark",
      "label": "Shadow Dark",
      "default": "#4f4e4e"
    },
    {
      "type": "color",
      "id": "neu_shadow_light",
      "label": "Shadow Light",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "neu_text",
      "label": "Text",
      "default": "#2c3e50"
    },
    {
      "type": "color",
      "id": "neu_text_muted",
      "label": "Text Muted",
      "default": "#8b95a3"
    },
    {
      "type": "header",
      "content": "Shape"
    }
  ]
}
{% endschema %}