{% render 'neu-settings', section: section %}

{% comment %}
  This section is used in the password template to render landing page shown
  when password protection is applied to a store.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<section class="password-neu">
  <div class="password-neu__shell">
    <div class="password-neu__card">
      <h1 class="password-neu__title">{{ 'password.title' | t }}</h1>

      {% if shop.password_message != blank %}
        <p class="password-neu__message">{{ shop.password_message }}</p>
      {% endif %}

      {%- comment -%} ── Newsletter signup ── {%- endcomment -%}
      <div class="password-neu__newsletter">
        <h2 class="password-neu__subtitle">{{ section.settings.newsletter_title }}</h2>
        <p class="password-neu__newsletter-text">{{ section.settings.newsletter_text }}</p>

        {% form 'customer', class: 'password-neu__form password-neu__form--newsletter' %}
          <input type="hidden" name="contact[tags]" value="newsletter,password-page">

          {% if form.posted_successfully? %}
            <div class="password-neu__success" role="status">
              <svg class="password-neu__success-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <span>{{ section.settings.newsletter_success }}</span>
            </div>
          {% else %}
            {% if form.errors %}
              <div class="password-neu__errors" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="password-neu__field">
              <label class="password-neu__label" for="newsletter-email">
                Email address
              </label>
              <input
                class="password-neu__input"
                type="email"
                name="contact[email]"
                id="newsletter-email"
                autocomplete="email"
                placeholder="your@email.com"
                required
              >
            </div>

            <button class="password-neu__button password-neu__button--notify" type="submit">
              {{ section.settings.newsletter_button }}
            </button>
          {% endif %}
        {% endform %}
      </div>

      {%- comment -%} ── Divider ── {%- endcomment -%}
      <div class="password-neu__divider">
        <span class="password-neu__divider-line"></span>
        <span class="password-neu__divider-text">or enter with password</span>
        <span class="password-neu__divider-line"></span>
      </div>

      {%- comment -%} ── Password form ── {%- endcomment -%}
      {% form 'storefront_password', class: 'password-neu__form' %}
        {% if form.errors %}
          <div class="password-neu__errors" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="password-neu__field">
          <label class="password-neu__label" for="password-input">
            {{ 'password.password' | t }}
          </label>

          <input
            class="password-neu__input"
            type="password"
            name="password"
            id="password-input"
            autocomplete="current-password"
            placeholder="{{ 'password.password' | t }}"
          >
        </div>

        <button class="password-neu__button" type="submit">
          {{ 'password.enter' | t }}
        </button>
      {% endform %}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} {
    background: #e6e9ee;
  }

  .password-neu {
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding: clamp(2rem, 6vw, 6rem) 1.25rem;
    color: var(--neu-text);
  }

  .password-neu__shell {
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
    padding: clamp(1rem, 2vw, 1.5rem);
    border-radius: 34px;
    background: var(--neu-bg);
    box-shadow: var(--neu-shadow-strong);
  }

  .password-neu__card {
    padding: clamp(1.75rem, 5vw, 3rem);
    border-radius: 30px;
  }

  .password-neu__title {
    margin: 0 0 0.75rem;
    text-align: center;
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--neu-text);
  }

  .password-neu__message {
    margin: 0 0 1.75rem;
    text-align: center;
    color: var(--neu-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  /* ── Newsletter ── */
  .password-neu__newsletter {
    margin-bottom: 0;
  }

  .password-neu__subtitle {
    margin: 0 0 0.35rem;
    text-align: center;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--neu-text);
  }

  .password-neu__newsletter-text {
    margin: 0 0 1.25rem;
    text-align: center;
    color: var(--neu-muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .password-neu__success {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 1rem 1.15rem;
    border-radius: 18px;
    background: #e2f0e5;
    color: #3a7d4a;
    font-weight: 600;
    font-size: 0.95rem;
    box-shadow: var(--shadow-neu-in-sm);
  }

  .password-neu__success-icon {
    flex-shrink: 0;
  }

  /* ── Divider ── */
  .password-neu__divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1.75rem 0;
  }

  .password-neu__divider-line {
    flex: 1;
    height: 2px;
    border-radius: 2px;
    background: var(--neu-bg);
    box-shadow: var(--shadow-neu-in-sm);
  }

  .password-neu__divider-text {
    flex-shrink: 0;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--neu-muted);
  }

  /* ── Form shared ── */
  .password-neu__form {
    display: grid;
    gap: 1.25rem;
  }

  .password-neu__field {
    display: grid;
    gap: 0.65rem;
  }

  .password-neu__label {
    padding-left: 0.15rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--neu-text);
  }

  .password-neu__input {
    width: 100%;
    padding: 1rem 1.15rem;
    border: 0;
    outline: 0;
    border-radius: 18px;
    background: var(--neu-bg);
    color: var(--neu-text);
    font-size: 1rem;
    box-shadow: var(--shadow-neu-in-sm);
    transition: box-shadow 0.25s ease, transform 0.25s ease, background 0.25s ease;
    appearance: none;
    -webkit-appearance: none;
  }

  .password-neu__input::placeholder {
    color: #95a0ad;
  }

  .password-neu__input:focus {
    background: #e6ebf1;
    box-shadow: var(--shadow-neu-in), 0 0 0 3px rgba(167, 139, 218, 0.18);
  }

  /* ── Buttons ── */
  .password-neu__button {
    width: 100%;
    padding: 1rem 1.2rem;
    border: 0;
    border-radius: 18px;
    background: linear-gradient(145deg, #b49ae6, var(--neu-accent-dark));
    color: #fff;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    cursor: pointer;
    box-shadow: var(--shadow-neu-accent);
    transition: transform 0.2s ease, box-shadow 0.25s ease, filter 0.25s ease;
  }

  .password-neu__button--notify {
    background: linear-gradient(145deg, #6ec985, #4aad62);
    box-shadow: var(--shadow-neu-success);
  }

  .password-neu__button--notify:hover {
    transform: translateY(-2px);
    filter: brightness(1.04);
    box-shadow: var(--shadow-neu-accent);
  }

  .password-neu__button:hover {
    transform: translateY(-2px);
    filter: brightness(1.03);
    box-shadow: var(--shadow-neu-accent);
  }

  .password-neu__button:active {
    transform: translateY(0);
    box-shadow: var(--shadow-neu-in-sm);
  }

  .password-neu__button:focus-visible {
    outline: none;
    box-shadow: var(--shadow-neu-accent), 0 0 0 3px rgba(167, 139, 218, 0.2);
  }

  .password-neu__button--notify:focus-visible {
    box-shadow: var(--shadow-neu-success), 0 0 0 3px rgba(74, 173, 98, 0.2);
  }

  /* ── Errors ── */
  .password-neu__errors {
    padding: 1rem 1.15rem;
    border-radius: 18px;
    background: #ebe6f4;
    color: #6c4c9b;
    box-shadow: var(--shadow-neu-in-sm);
    font-size: 0.95rem;
  }

  .password-neu__errors .errors,
  .password-neu__errors ul {
    margin: 0;
    padding-left: 1.1rem;
  }

  .password-neu__errors li + li {
    margin-top: 0.35rem;
  }

  .password-neu__errors a {
    color: inherit;
  }

  /* ── Responsive ── */
  @media (max-width: 749px) {
    .password-neu__shell {
      border-radius: 28px;
    }

    .password-neu__card {
      padding: 1.5rem;
      border-radius: 24px;
    }

    .password-neu__input,
    .password-neu__button,
    .password-neu__errors,
    .password-neu__success {
      border-radius: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .password-neu__input,
    .password-neu__button {
      transition: none;
    }
  }
</style>

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    {
      "type": "header",
      "content": "Neuromatic Colors"
    },
    {
      "type": "color",
      "id": "neu_bg",
      "label": "Background",
      "default": "#e6e9ee"
    },
    {
      "type": "color",
      "id": "neu_shadow_dark",
      "label": "Shadow Dark",
      "default": "#4f4e4e"
    },
    {
      "type": "color",
      "id": "neu_shadow_light",
      "label": "Shadow Light",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "neu_text",
      "label": "Text",
      "default": "#2c3e50"
    },
    {
      "type": "color",
      "id": "neu_text_muted",
      "label": "Text Muted",
      "default": "#8b95a3"
    },
    {
      "type": "header",
      "content": "Shape"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter title",
      "default": "Be the first to know"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter description",
      "default": "Sign up to get notified when we launch. No spam, just one email when the store goes live."
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Newsletter button text",
      "default": "Notify me"
    },
    {
      "type": "text",
      "id": "newsletter_success",
      "label": "Success message",
      "default": "You're on the list! We'll notify you when we launch."
    }
  ]
}
{% endschema %}