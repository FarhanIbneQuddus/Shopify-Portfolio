[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Heading"
      },
      {
        "type": "font_picker",
        "id": "type_header_font",
        "default": "assistant_n4",
        "label": "Heading Font"
      },
      {
        "type": "header",
        "content": "Body"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "assistant_n4",
        "label": "Body Font"
      }
    ]
  },
  {
    "name": "Layouts",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "Page Width",
        "options": [
          {
            "value": "90rem",
            "label": "Narrow"
          },
          {
            "value": "110rem",
            "label": "Wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Page Margin",
        "default": 20
      }
    ]
  },
  {
    "name": "Site Audio",
    "settings": [
      {
        "type": "paragraph",
        "content": "Add click sounds and background music to your storefront. Upload audio files to Settings → Files, then paste the URL below."
      },

      {
        "type": "header",
        "content": "🖱️ Click Sound"
      },
      {
        "type": "checkbox",
        "id": "sound_enabled",
        "label": "Enable click sound",
        "default": false,
        "info": "Plays a sound when visitors click buttons, links, and other elements."
      },
      {
        "type": "url",
        "id": "sound_file_url",
        "label": "Click sound file URL",
        "info": "Upload a short .mp3 to Settings → Files, then paste the URL here."
      },
      {
        "type": "range",
        "id": "sound_volume",
        "label": "Click sound volume",
        "min": 0,
        "max": 100,
        "step": 5,
        "default": 25,
        "unit": "%"
      },
      {
        "type": "select",
        "id": "sound_toggle_position",
        "label": "Click sound button position",
        "default": "bottom-right",
        "options": [
          { "value": "bottom-right", "label": "Bottom Right" },
          { "value": "bottom-left",  "label": "Bottom Left"  },
          { "value": "top-right",    "label": "Top Right"    },
          { "value": "top-left",     "label": "Top Left"     }
        ]
      },
      {
        "type": "checkbox",
        "id": "sound_default_on",
        "label": "Click sound on by default",
        "default": false,
        "info": "First-time visitors will have click sound turned on. Returning visitors keep their own preference."
      },

      {
        "type": "header",
        "content": "🎵 Background Music"
      },
      {
        "type": "checkbox",
        "id": "music_enabled",
        "label": "Enable background music",
        "default": false,
        "info": "Adds a music toggle button so visitors can play looping background music."
      },
      {
        "type": "url",
        "id": "music_file_url",
        "label": "Music file URL",
        "info": "Upload your .mp3 to Settings → Files, then paste the URL here."
      },
      {
        "type": "range",
        "id": "music_volume",
        "label": "Music volume",
        "min": 0,
        "max": 100,
        "step": 5,
        "default": 50,
        "unit": "%"
      },
      {
        "type": "select",
        "id": "music_toggle_position",
        "label": "Music button position",
        "default": "bottom-right",
        "options": [
          { "value": "bottom-right", "label": "Bottom Right" },
          { "value": "bottom-left",  "label": "Bottom Left"  },
          { "value": "top-right",    "label": "Top Right"    },
          { "value": "top-left",     "label": "Top Left"     }
        ]
      },
      {
        "type": "range",
        "id": "music_toggle_offset",
        "label": "Music button spacing",
        "min": 0,
        "max": 300,
        "step": 10,
        "default": 140,
        "unit": "px",
        "info": "Distance from the edge. If both buttons are in the same corner, increase this to prevent overlap."
      },
      {
        "type": "checkbox",
        "id": "music_autoplay",
        "label": "Resume music for returning visitors",
        "default": true,
        "info": "If a visitor turned music on before, try to resume it on their next visit."
      }
    ]
  },
  {
    "name": "Page Loader",
    "settings": [
      {
        "type": "header",
        "content": "Page Transition Loader"
      },
      {
        "type": "paragraph",
        "content": "A neumorphic loading animation that appears when visitors navigate between pages. It does not appear on page reloads or direct URL visits."
      },
      {
        "type": "checkbox",
        "id": "loader_enable",
        "label": "Enable page transition loader",
        "default": false
      },
      {
        "type": "range",
        "id": "loader_extra_delay",
        "label": "Extra display time",
        "info": "Additional time (in milliseconds) the loader stays visible after the page finishes loading. 0 is the fastest. Higher values create a more dramatic entrance.",
        "min": 0,
        "max": 1500,
        "step": 100,
        "default": 0,
        "unit": "ms"
      }
    ]
  }
]
